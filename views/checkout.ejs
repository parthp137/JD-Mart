<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>JD Mart | Checkout</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-sRIl4kxILFvY47J16cr9ZwB07vP4J8+LH7qKQnuqkuIAvNWLzeN8tE5YBujZqJLB" crossorigin="anonymous">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/7.0.1/css/all.min.css">
    <link rel="stylesheet" href="/css/style.css">
    <style>
        .checkout-header {
            background: linear-gradient(135deg, #16a34a 0%, #15803d 100%);
            color: white;
            padding: 30px 0;
            margin-bottom: 30px;
        }
        .step-indicator {
            display: flex;
            justify-content: space-between;
            margin-bottom: 30px;
        }
        .step-item {
            flex: 1;
            text-align: center;
            padding: 15px;
        }
        .step-item.active .step-circle {
            background: #16a34a;
            color: white;
        }
        .step-item.active .step-title {
            font-weight: 600;
            color: #16a34a;
        }
        .step-circle {
            width: 40px;
            height: 40px;
            border-radius: 50%;
            background: #e5e7eb;
            display: flex;
            align-items: center;
            justify-content: center;
            margin: 0 auto 8px;
            font-weight: 600;
        }
        .step-title {
            font-size: 14px;
            color: #666;
        }
        .address-option {
            padding: 15px;
            border: 2px solid #e5e7eb;
            border-radius: 8px;
            margin-bottom: 12px;
            cursor: pointer;
            transition: all 0.3s;
        }
        .address-option:hover {
            border-color: #16a34a;
            background: #f0fdf4;
        }
        .address-option.selected {
            border-color: #16a34a;
            background: #f0fdf4;
        }
        .address-option input[type="radio"] {
            margin-right: 12px;
        }
        .delivery-info {
            background: #f9fafb;
            padding: 15px;
            border-radius: 8px;
            margin-top: 20px;
        }
        .order-item {
            display: flex;
            justify-content: space-between;
            padding: 12px 0;
            border-bottom: 1px solid #e5e7eb;
        }
        .order-item:last-child {
            border-bottom: none;
        }
        .item-details {
            flex: 1;
        }
        .item-name {
            font-weight: 500;
            margin-bottom: 4px;
        }
        .item-qty {
            font-size: 14px;
            color: #666;
        }
        .summary-row {
            display: flex;
            justify-content: space-between;
            padding: 12px 0;
        }
        .summary-row.total {
            border-top: 2px solid #e5e7eb;
            margin-top: 12px;
            padding-top: 12px;
            font-weight: 600;
            font-size: 18px;
            color: #16a34a;
        }
    </style>
</head>
<body>

<nav class="navbar navbar-expand-lg navbar-light bg-body-light border-bottom sticky-top">
  <div class="container-fluid">
    <a class="navbar-brand d-flex align-items-center" href="/products">
      <img src="/images/image.png" alt="JD Mart Logo" height="40" style="border-radius: 8px;"/>
      <span class="ms-2 fw-bold">JD Mart</span>
    </a>
  </div>
</nav>

<div class="checkout-header">
    <div class="container">
        <h2 class="mb-0"><i class="fa-solid fa-clipboard-check me-2"></i>Order Confirmation</h2>
    </div>
</div>

<div class="container">
    <% if (typeof error !== 'undefined' && error) { %>
        <div class="alert alert-danger"><%= error %></div>
    <% } %>

    <% if (typeof message !== 'undefined' && message) { %>
        <div class="alert alert-success"><%= message %></div>
    <% } %>

    <div class="step-indicator">
        <div class="step-item active">
            <div class="step-circle">1</div>
            <div class="step-title">Review Order</div>
        </div>
        <div class="step-item active">
            <div class="step-circle">2</div>
            <div class="step-title">Delivery Address</div>
        </div>
        <div class="step-item">
            <div class="step-circle">3</div>
            <div class="step-title">Confirm & Pay</div>
        </div>
    </div>

    <div class="row">
        <!-- Order Summary -->
        <div class="col-lg-8">
            <div class="card mb-4">
                <div class="card-header bg-white">
                    <h5 class="mb-0"><i class="fa-solid fa-boxes-stacked me-2"></i>Order Items</h5>
                </div>
                <div class="card-body">
                    <% cart.items.forEach(item => { %>
                        <div class="order-item">
                            <div class="item-details">
                                <div class="item-name"><%= item.product.name %></div>
                                <div class="item-qty">Quantity: <%= item.quantity %> kg × ₹<%= (item.priceAtAdd / 100).toFixed(2) %>/kg</div>
                            </div>
                            <div style="text-align: right;">
                                <strong>₹<%= ((item.quantity * item.priceAtAdd) / 100).toFixed(2) %></strong>
                            </div>
                        </div>
                    <% }) %>
                </div>
            </div>

            <!-- Delivery Address Selection -->
            <div class="card">
                <div class="card-header bg-white">
                    <h5 class="mb-0"><i class="fa-solid fa-location-dot me-2"></i>Delivery Address</h5>
                </div>
                <div class="card-body">
                    <form id="checkoutForm" action="/orders/place" method="POST">
                        <% if (user.defaultAddress) { %>
                            <div class="mb-3">
                                <p class="text-muted mb-3">Delivery address:</p>
                                <label class="address-option selected">
                                    <input type="radio" name="deliveryAddress" value="<%= user.defaultAddress %>" checked class="addressRadio">
                                    <strong><i class="fa-solid fa-check-circle me-2" style="color: #16a34a;"></i>Current Address</strong>
                                    <br>
                                    <small class="text-muted"><%= user.defaultAddress %></small>
                                </label>
                            </div>
                        <% } else { %>
                            <div class="alert alert-warning">
                                <i class="fa-solid fa-exclamation-triangle me-2"></i>
                                No delivery address found. Please add one in your profile first.
                            </div>
                            <a href="/profile" class="btn btn-warning">Update Profile</a>
                            <% return; %>
                        <% } %>

                        <div class="delivery-info">
                            <div class="d-flex align-items-start">
                                <i class="fa-solid fa-info-circle me-2 mt-1" style="color: #16a34a;"></i>
                                <div>
                                    <strong>Estimated Delivery</strong>
                                    <p class="mb-0 text-muted">Your order will be delivered within 3-5 business days</p>
                                </div>
                            </div>
                        </div>

                        <!-- Payment Method Selection -->
                        <div class="card mt-4">
                            <div class="card-header bg-white">
                                <h5 class="mb-0"><i class="fa-solid fa-credit-card me-2"></i>Payment Method</h5>
                            </div>
                            <div class="card-body">
                                <div class="row g-3">
                                    <div class="col-md-6">
                                        <label class="payment-option p-3 border border-2 border-secondary rounded text-center cursor-pointer" style="cursor: pointer;">
                                            <input type="radio" name="paymentMethod" value="bank-transfer" checked>
                                            <div><i class="fa-solid fa-building-columns" style="font-size: 1.5rem; color: #16a34a; margin-bottom: 0.5rem;"></i></div>
                                            <div class="fw-500">Bank Transfer</div>
                                            <small class="text-muted">Direct bank payment</small>
                                        </label>
                                    </div>
                                    <div class="col-md-6">
                                        <label class="payment-option p-3 border border-2 border-secondary rounded text-center cursor-pointer" style="cursor: pointer;">
                                            <input type="radio" name="paymentMethod" value="upi">
                                            <div><i class="fa-solid fa-mobile" style="font-size: 1.5rem; color: #16a34a; margin-bottom: 0.5rem;"></i></div>
                                            <div class="fw-500">UPI</div>
                                            <small class="text-muted">Instant payment</small>
                                        </label>
                                    </div>
                                    <div class="col-md-6">
                                        <label class="payment-option p-3 border border-2 border-secondary rounded text-center cursor-pointer" style="cursor: pointer;">
                                            <input type="radio" name="paymentMethod" value="debit-card">
                                            <div><i class="fa-solid fa-credit-card" style="font-size: 1.5rem; color: #16a34a; margin-bottom: 0.5rem;"></i></div>
                                            <div class="fw-500">Debit Card</div>
                                            <small class="text-muted">Visa/Mastercard</small>
                                        </label>
                                    </div>
                                    <div class="col-md-6">
                                        <label class="payment-option p-3 border border-2 border-secondary rounded text-center cursor-pointer" style="cursor: pointer;">
                                            <input type="radio" name="paymentMethod" value="cod">
                                            <div><i class="fa-solid fa-hand-holding-dollar" style="font-size: 1.5rem; color: #16a34a; margin-bottom: 0.5rem;"></i></div>
                                            <div class="fw-500">Cash on Delivery</div>
                                            <small class="text-muted">Pay on delivery</small>
                                        </label>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Order Summary Card with Taxes -->
                        <div class="card mt-4">
                            <div class="card-header bg-white">
                                <h5 class="mb-0">Price Breakdown</h5>
                            </div>
                            <div class="card-body">
                                <div class="summary-row">
                                    <span>Subtotal (<%= cart.getTotalQuantity() %> units)</span>
                                    <span>₹<%= (totalAmount / 100).toFixed(2) %></span>
                                </div>
                                <div class="summary-row">
                                    <span>Taxes (GST)</span>
                                    <span>₹<%= ((totalAmount * 0.05) / 100).toFixed(2) %></span>
                                </div>
                                <div class="summary-row">
                                    <span>Packaging</span>
                                    <span>₹<%= (50).toFixed(2) %></span>
                                </div>
                                <div class="summary-row">
                                    <span>Delivery</span>
                                    <span class="text-success">FREE</span>
                                </div>
                                <div class="summary-row total" style="margin-top: 12px; padding-top: 12px; border-top: 2px solid #e5e7eb;">
                                    <span>Total Amount</span>
                                    <span>₹<%= ((totalAmount * 1.05 + 5000) / 100).toFixed(2) %></span>
                                </div>
                            </div>
                        </div>

                        <div class="mt-4 d-grid gap-2">
                            <button type="button" class="btn btn-outline-info" id="downloadInvoiceBtn">
                                <i class="fa-solid fa-download me-2"></i>Download Invoice Preview
                            </button>
                            <button type="submit" class="btn btn-success btn-lg">
                                <i class="fa-solid fa-check-circle me-2"></i>Place Order
                            </button>
                            <a href="/cart" class="btn btn-outline-secondary">
                                <i class="fa-solid fa-arrow-left me-2"></i>Back to Cart
                            </a>
                        </div>
                    </form>
                </div>
            </div>
        </div>

        <!-- Right Sidebar Summary -->
        <div class="col-lg-4">
            <div class="card sticky-top" style="top: 80px;">
                <div class="card-header bg-white">
                    <h5 class="mb-0">Order Summary</h5>
                </div>
                <div class="card-body">
                    <div class="summary-row">
                        <strong>Subtotal</strong>
                        <span>₹<%= (totalAmount / 100).toFixed(2) %></span>
                    </div>
                    <div class="summary-row">
                        <strong>Delivery</strong>
                        <span class="text-success">FREE</span>
                    </div>
                    <hr>
                    <div class="summary-row total">
                        <strong>Total Amount</strong>
                        <strong style="color: #16a34a;">₹<%= (totalAmount / 100).toFixed(2) %></strong>
                    </div>
                    <div class="alert alert-info mt-3" role="alert">
                        <i class="fa-solid fa-shield-check me-2"></i>
                        <small><strong>Safe & Secure:</strong> Your payment is encrypted and secure</small>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<footer class="jd-footer-section mt-5">
  <div class="container-fluid px-5 mt-3">
    <div class="text-center pb-3">
      <small>© <%= new Date().getFullYear() %> JD Mart. All rights reserved.</small>
    </div>
  </div>
</footer>

<script>
    // Payment method selection styling
    document.querySelectorAll('.payment-option input[type="radio"]').forEach(radio => {
        radio.addEventListener('change', function() {
            document.querySelectorAll('.payment-option').forEach(opt => {
                opt.classList.remove('border-success');
                opt.classList.add('border-secondary');
            });
            this.closest('.payment-option').classList.add('border-success');
            this.closest('.payment-option').classList.remove('border-secondary');
        });
    });

    // Set default payment method styling
    document.querySelector('.payment-option input[checked]')?.closest('.payment-option')?.classList.add('border-success');
    document.querySelector('.payment-option input[checked]')?.closest('.payment-option')?.classList.remove('border-secondary');

    // Invoice download functionality
    document.getElementById('downloadInvoiceBtn')?.addEventListener('click', function() {
        const invoiceData = {
            orderNumber: 'ORD-' + Date.now(),
            date: new Date().toLocaleDateString('en-IN'),
            items: [
                <% cart.items.forEach((item, idx) => { %>
                    {
                        name: '<%= item.product.name %>',
                        quantity: <%= item.quantity %>,
                        price: <%= (item.priceAtAdd / 100).toFixed(2) %>,
                        total: <%= ((item.quantity * item.priceAtAdd) / 100).toFixed(2) %>
                    }<%= idx < cart.items.length - 1 ? ',' : '' %>
                <% }); %>
            ],
            subtotal: <%= (totalAmount / 100).toFixed(2) %>,
            tax: <%= ((totalAmount * 0.05) / 100).toFixed(2) %>,
            packaging: 50,
            total: <%= ((totalAmount * 1.05 + 5000) / 100).toFixed(2) %>,
            address: '<%= user.defaultAddress %>'
        };

        // Generate simple text-based invoice
        let invoiceText = `
╔════════════════════════════════════════╗
║           JD MART - INVOICE            ║
╚════════════════════════════════════════╝

Order Number: ${invoiceData.orderNumber}
Date: ${invoiceData.date}
────────────────────────────────────────

ITEMS:
`;
        invoiceData.items.forEach(item => {
            invoiceText += `${item.name}
  Qty: ${item.quantity} × ₹${item.price} = ₹${item.total}
`;
        });

        invoiceText += `
────────────────────────────────────────
Subtotal:        ₹${invoiceData.subtotal.toFixed(2)}
Taxes (GST 5%):  ₹${invoiceData.tax.toFixed(2)}
Packaging:       ₹${invoiceData.packaging.toFixed(2)}
────────────────────────────────────────
TOTAL:           ₹${invoiceData.total.toFixed(2)}

Delivery Address:
${invoiceData.address}

────────────────────────────────────────
Thank you for your order!
`;

        // Create and download file
        const element = document.createElement('a');
        element.setAttribute('href', 'data:text/plain;charset=utf-8,' + encodeURIComponent(invoiceText));
        element.setAttribute('download', `Invoice_${invoiceData.orderNumber}.txt`);
        element.style.display = 'none';
        document.body.appendChild(element);
        element.click();
        document.body.removeChild(element);
    });

    document.querySelectorAll('.address-option').forEach(option => {
        option.addEventListener('click', function() {
            document.querySelectorAll('.address-option').forEach(o => o.classList.remove('selected'));
            this.classList.add('selected');
            this.querySelector('input[type="radio"]').checked = true;
        });
    });
</script>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
