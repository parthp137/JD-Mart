<!-- JD Mart Shared Navigation Header -->
<nav class="navbar navbar-expand-lg border-bottom sticky-top">
  <div class="container-fluid">
    <!-- LOGO -->
    <a class="navbar-brand d-flex align-items-center" href="/products">
      <img src="/images/image.png" alt="JD Mart Logo" height="40" style="border-radius: 8px;"/>
      <span class="ms-2 fw-bold">JD Mart</span>
    </a>

    <!-- LOCATION (Hidden on mobile by default) -->
    <div class="ms-auto me-3 d-none d-lg-flex align-items-center">
      <i class="fa-solid fa-location-dot me-1" style="color: #16a34a;"></i>
      <span id="locationText" style="font-size: 14px;">Getting location...</span>
    </div>

    <!-- MOBILE TOGGLE -->
    <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarContent">
      <span class="navbar-toggler-icon"></span>
    </button>

    <!-- NAVBAR CONTENT -->
    <div class="collapse navbar-collapse" id="navbarContent">
      <!-- SEARCH BAR -->
      <div class="navbar-search ms-lg-3 my-2 my-lg-0 position-relative">
        <input type="text" id="productSearch" value="<%= typeof search !== 'undefined' ? search : '' %>" placeholder="Search for crops, grains, spices..." class="form-control" />
        <kbd class="search-kbd d-none d-lg-inline-block" title="Press / to search">/</kbd>
      </div>

      <!-- RIGHT ICONS -->
      <div class="navbar-icons ms-lg-auto d-flex align-items-center gap-2">
        <!-- MULTI-LINGUAL REGIONAL PICKER -->
        <div class="dropdown lang-picker-dropdown">
          <button class="lang-btn dropdown-toggle" type="button" id="langDropdownBtn" data-bs-toggle="dropdown" aria-expanded="false">
            <i class="fa-solid fa-globe text-success"></i>
            <span id="currentLangLabel">EN</span>
          </button>
          <ul class="dropdown-menu dropdown-menu-end shadow-sm border-0 rounded-3 py-1" aria-labelledby="langDropdownBtn" style="font-size: 0.85rem;">
            <li><a class="dropdown-item fw-semibold" href="javascript:void(0)" onclick="setLanguage('en')">English (EN)</a></li>
            <li><a class="dropdown-item fw-semibold" href="javascript:void(0)" onclick="setLanguage('hi')">हिन्दी (Hindi)</a></li>
            <li><a class="dropdown-item fw-semibold" href="javascript:void(0)" onclick="setLanguage('gu')">ગુજરાતી (Gujarati)</a></li>
            <li><a class="dropdown-item fw-semibold" href="javascript:void(0)" onclick="setLanguage('pa')">ਪੰਜਾਬੀ (Punjabi)</a></li>
          </ul>
        </div>

        <!-- THEME TOGGLE (Light / Dark) -->
        <button type="button" class="theme-toggle-btn" id="themeToggleBtn" onclick="toggleTheme()" title="Toggle Dark/Light Mode">
          <i class="fa-regular fa-moon" id="themeIcon"></i>
        </button>

        <!-- NOTIFICATIONS -->
        <a href="/notifications" class="notification-icon" title="Notifications">
          <i class="fa-regular fa-bell"></i>
          <% if (typeof notificationCount !== 'undefined' && notificationCount > 0) { %>
            <span class="notification-badge"><%= notificationCount > 9 ? '9+' : notificationCount %></span>
          <% } %>
        </a>

        <!-- CART DRAWER TRIGGER -->
        <a href="javascript:void(0)" onclick="openCartDrawer()" class="cart-icon-link" id="navCartLink" title="View Quick Cart Drawer">
          <i class="fa-solid fa-cart-shopping"></i>
          <% if (typeof cartCount !== 'undefined' && cartCount > 0) { %>
            <span class="cart-badge" id="navCartBadge"><%= cartCount %></span>
          <% } %>
        </a>


        <!-- USER DROPDOWN -->
        <div class="navbar-user" id="userDropdown">
          <div class="avatar">
            <%= user && user.fullName ? user.fullName.charAt(0).toUpperCase() : "U" %>
          </div>
          <span><%= user && user.fullName ? user.fullName.split(" ")[0] : "Guest" %></span>
          <i class="fa-solid fa-chevron-down"></i>

          <div class="jd-user-menu">
            <div class="jd-user-info">
              <strong><%= user && user.fullName ? user.fullName : "Guest User" %></strong>
              <small><%= user && user.email ? user.email : "Not logged in" %></small>
            </div>
            <% if (user) { %>
              <a href="/profile"><i class="fa-regular fa-user"></i> Profile</a>
              <a href="/orders"><i class="fa-solid fa-box"></i> Orders</a>
              <a href="/rfqs"><i class="fa-solid fa-handshake"></i> Bulk Quotes (RFQ)</a>
              <% if (user.role === 'admin') { %>
                <a href="/admin"><i class="fa-solid fa-lock"></i> Admin Dashboard</a>
              <% } %>
              <div class="jd-divider"></div>
              <a href="/logout" class="logout"><i class="fa-solid fa-right-from-bracket"></i> Logout</a>
            <% } else { %>
              <a href="/login"><i class="fa-solid fa-right-to-bracket"></i> Login</a>
              <a href="/register"><i class="fa-solid fa-user-plus"></i> Register</a>
            <% } %>
          </div>
        </div>
      </div>
    </div>
  </div>
</nav>

