<!-- 3. SLIDE-OUT QUICK RFQ DRAWER & BACKDROP -->
<div class="jd-rfq-backdrop" id="jdRfqBackdrop" onclick="closeRfqDrawer()"></div>
<div class="jd-rfq-drawer" id="jdRfqDrawer">
  <div class="jd-rfq-header">
    <div>
      <h5 class="mb-0 fw-bold"><i class="fa-solid fa-handshake me-2"></i> Instant RFQ Negotiation</h5>
      <small class="text-white-50">Direct wholesale price counter-offer</small>
    </div>
    <button type="button" class="btn-close btn-close-white" onclick="closeRfqDrawer()"></button>
  </div>
  
  <form action="/rfq/submit" method="POST" id="drawerRfqForm" class="d-flex flex-column h-100">
    <input type="hidden" name="productId" id="drawerProductId" value="">
    
    <div class="jd-rfq-body">
      <!-- Selected Crop Info -->
      <div class="p-3 bg-light rounded-3 mb-3 border">
        <span class="text-muted small d-block">Negotiating For:</span>
        <h6 class="fw-bold mb-1 text-dark" id="drawerProductName">Product Name</h6>
        <div class="d-flex justify-content-between align-items-center mt-2">
          <span class="small text-muted">Listed Rate:</span>
          <strong class="text-success" id="drawerListedRate">₹0.00/quintal</strong>
        </div>
      </div>

      <!-- Volume & Target Counter Offer -->
      <div class="row g-3 mb-3">
        <div class="col-6">
          <label class="form-label fw-bold small">Required Volume</label>
          <div class="input-group input-group-sm">
            <input type="number" name="requestedQuantity" id="drawerQuantity" class="form-control" placeholder="50" min="1" required oninput="recalcDrawerOffer()">
            <span class="input-group-text">Qtl</span>
          </div>
          <small class="text-muted" style="font-size: 0.72rem;">1 Quintal = 100 kg</small>
        </div>
        <div class="col-6">
          <label class="form-label fw-bold small">Target Offer (₹/Qtl)</label>
          <div class="input-group input-group-sm">
            <span class="input-group-text">₹</span>
            <input type="number" name="targetPricePerQuintal" id="drawerTargetPrice" class="form-control" placeholder="3800" min="1" step="1" required oninput="recalcDrawerOffer()">
          </div>
          <small class="text-muted" style="font-size: 0.72rem;">Proposed purchase rate</small>
        </div>
      </div>

      <!-- Offer Summary Box -->
      <div class="calc-breakdown-box mb-3" id="drawerCalcBox">
        <div class="d-flex justify-content-between mb-1">
          <span class="text-muted">Total Proposed Value:</span>
          <strong class="text-dark" id="drawerTotalProposed">₹0.00</strong>
        </div>
        <div class="d-flex justify-content-between small">
          <span class="text-muted">Variance from Listed Price:</span>
          <span class="fw-bold" id="drawerPriceVariance">0%</span>
        </div>
      </div>

      <!-- Logistics Mode Preference -->
      <div class="mb-3">
        <label class="form-label fw-bold small">Logistics & Freight Preference</label>
        <div class="logistics-toggle-group">
          <div class="logistics-toggle-card selected" id="logisticsDoorstep" onclick="selectLogistics('Doorstep Delivery')">
            <i class="fa-solid fa-truck-fast mb-1 d-block text-success"></i>
            <strong>Doorstep Delivery</strong>
            <small class="d-block text-muted" style="font-size: 0.7rem;">Supplier manages freight</small>
          </div>
          <div class="logistics-toggle-card" id="logisticsPickup" onclick="selectLogistics('Ex-Mandi Yard Pickup')">
            <i class="fa-solid fa-warehouse mb-1 d-block text-secondary"></i>
            <strong>Ex-Mandi Pickup</strong>
            <small class="d-block text-muted" style="font-size: 0.7rem;">Buyer arranges vehicle</small>
          </div>
        </div>
      </div>

      <!-- Delivery Location -->
      <div class="mb-3">
        <label class="form-label fw-bold small">Delivery APMC / Warehouse Location</label>
        <div class="input-group input-group-sm">
          <span class="input-group-text"><i class="fa-solid fa-location-dot text-success"></i></span>
          <input type="text" name="deliveryLocation" id="drawerLocation" class="form-control" placeholder="e.g. Unjha APMC Yard, Gujarat" required>
        </div>
      </div>

      <!-- Buyer Notes & Packaging -->
      <div class="mb-2">
        <label class="form-label fw-bold small">Packaging & Target Delivery Window</label>
        <textarea name="buyerNotes" class="form-control form-control-sm" rows="2" placeholder="e.g. 50kg jute bags, delivery needed within 5 days, lab certificate required."></textarea>
      </div>
    </div>

    <div class="jd-rfq-footer">
      <button type="submit" class="btn btn-success w-100 py-2 fw-bold">
        <i class="fa-solid fa-paper-plane me-1"></i> Send Instant RFQ Offer
      </button>
    </div>
  </form>
</div>

