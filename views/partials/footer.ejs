            <div class="p-2 border rounded-2 bg-white">
              <small class="text-muted d-block" style="font-size: 0.72rem;">GRAIN PURITY</small>
              <strong class="text-success"><i class="fa-solid fa-check-double text-xs me-1"></i> 99.4% Clean</strong>
            </div>
          </div>
          <div class="col-6">
            <div class="p-2 border rounded-2 bg-white">
              <small class="text-muted d-block" style="font-size: 0.72rem;">FOREIGN MATTER</small>
              <strong class="text-dark">&lt; 0.5% (Allowed: 1%)</strong>
            </div>
          </div>
          <div class="col-6">
            <div class="p-2 border rounded-2 bg-white">
              <small class="text-muted d-block" style="font-size: 0.72rem;">HARVEST WINDOW</small>
              <strong class="text-dark" id="modalHarvestDate">Current Season</strong>
            </div>
          </div>
          <div class="col-6">
            <div class="p-2 border rounded-2 bg-white">
              <small class="text-muted d-block" style="font-size: 0.72rem;">NPOP ORGANIC</small>
              <strong class="text-success" id="modalOrganicStatus"><i class="fa-solid fa-leaf me-1"></i> Certified</strong>
            </div>
          </div>
        </div>

        <!-- Supplier Verification Stamp -->
