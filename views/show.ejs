<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>JD Mart | <%= product.name %></title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/7.0.1/css/all.min.css">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/style.css">
  <style>
    .supplier-card {
      border: 1px solid #dcfce7;
      background: #f0fdf4;
      border-radius: 12px;
      padding: 1rem;
    }
    .tiered-table {
      font-size: 0.9rem;
    }
    .tiered-table th {
      background-color: #f8fafc;
    }
    .discount-pill {
      background: #dcfce7;
      color: #15803d;
      font-weight: 600;
      padding: 0.25rem 0.5rem;
      border-radius: 6px;
      font-size: 0.8rem;
    }
    .rfq-box {
      border: 1px dashed #16a34a;
      background: #fafaf9;
      border-radius: 12px;
      padding: 1rem;
    }
  </style>
</head>
<body class="bg-light">

<%- include("partials/header") %>

<div class="container my-4">
  <a href="/products" class="jd-back mb-3 d-inline-block text-decoration-none">
    <i class="fa-solid fa-arrow-left me-1"></i> Back to Agricultural Catalog
  </a>

  <% if (typeof error !== 'undefined' && error) { %>
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
      <i class="fa-solid fa-circle-exclamation me-2"></i> <%= error %>
      <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
  <% } %>

  <% if (typeof message !== 'undefined' && message) { %>
    <div class="alert alert-success alert-dismissible fade show" role="alert">
      <i class="fa-solid fa-circle-check me-2"></i> <%= message %>
      <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
  <% } %>

  <div class="jd-view-container bg-white p-4 rounded-4 shadow-sm">
    <!-- LEFT IMAGE PANEL -->
    <div class="jd-view-image">
      <!-- 2D / 3D Media View Switcher -->
      <div class="jd-media-switch-tabs mb-3">
        <button type="button" class="jd-media-tab-btn active" id="tabMedia2D" onclick="switchMediaView('2d')">
          <i class="fa-regular fa-image"></i> High-Res Photo
        </button>
        <button type="button" class="jd-media-tab-btn" id="tabMedia3D" onclick="switchMediaView('3d')">
          <i class="fa-solid fa-cube text-success"></i> 3D 360° Inspection Stage
        </button>
      </div>

      <div id="media2DWrapper" class="position-relative">
        <img
          src="<%= getImageUrl(product.images) %>"
          alt="<%= product.name %>"
          class="jd-view-image-tag rounded-3"
          onerror="this.onerror=null;this.src='<%= getCropPlaceholder(product.category || product.name) %>'"
        >
        <% if (product.belowMarketPercent > 0) { %>
          <span class="jd-view-market">
            <i class="fa-solid fa-arrow-trend-down"></i>
            <%= product.belowMarketPercent %>% below mandi rate
          </span>
        <% } %>

        <span class="jd-view-grade quality-chip quality-chip-grade" onclick="openCropInspection('<%= product.name.replace(/'/g, "\\'") %>', '<%= product.grade %>', '<%= product.category %>', '11.8%', '<%= (product.supplier && product.supplier.name) ? product.supplier.name.replace(/'/g, "\\'") : 'APMC Mandi Farmer' %>')" style="cursor: pointer;" title="Click to view lab certificate">
          <i class="fa-regular fa-star"></i> Grade <%= product.grade %> Certified
        </span>

        <button type="button" class="btn btn-sm btn-light border text-success fw-bold position-absolute top-0 end-0 m-3 shadow-sm rounded-pill px-2.5 py-1" onclick="openTraceabilityPassport('<%= product.name.replace(/'/g, "\\'") %>', '<%= product.grade %>', '<%= product.category %>', '<%= (product.supplier && product.supplier.name) ? product.supplier.name.replace(/'/g, "\\'") : 'Patel Organic Farms' %>', '<%= (product.supplier && product.supplier.location) ? product.supplier.location.replace(/'/g, "\\'") : 'Unjha APMC Yard, Gujarat' %>')" title="Inspect Origin Farm & Soil Health">
          <i class="fa-solid fa-seedling me-1"></i> Traceability Passport
        </button>
      </div>

      <!-- 3D Interactive Inspection Stage Container -->
      <div id="product3DStage" class="jd-3d-stage d-none">
        <div class="position-absolute top-0 start-0 m-3 d-flex align-items-center gap-1 bg-white bg-opacity-75 px-2 py-1 rounded-pill small fw-bold text-success border border-success-subtle" style="z-index: 5;">
          <i class="fa-solid fa-hand-pointer text-xs"></i> Drag to rotate 360°
        </div>
      </div>

      <!-- SUPPLIER CREDENTIALS CARD -->
      <div class="supplier-card mt-3">
        <div class="d-flex align-items-center justify-content-between mb-2">
          <div class="d-flex align-items-center">
            <div class="bg-success text-white rounded-circle p-2 me-2" style="width: 32px; height: 32px; display: flex; align-items: center; justify-content: center;">
              <i class="fa-solid fa-check text-xs"></i>
            </div>
            <div>
              <h6 class="mb-0 fw-bold text-success"><%= (product.supplier && product.supplier.name) ? product.supplier.name : 'Verified Mandi Supplier' %></h6>
              <small class="text-muted"><i class="fa-solid fa-location-dot"></i> <%= (product.supplier && product.supplier.location) ? product.supplier.location : 'APMC Hub' %></small>
            </div>
          </div>
          <button type="button" class="btn btn-outline-success btn-sm rounded-pill" onclick="openTraceabilityPassport('<%= product.name.replace(/'/g, "\\'") %>', '<%= product.grade %>', '<%= product.category %>', '<%= (product.supplier && product.supplier.name) ? product.supplier.name.replace(/'/g, "\\'") : 'Patel Organic Farms' %>', '<%= (product.supplier && product.supplier.location) ? product.supplier.location.replace(/'/g, "\\'") : 'Unjha APMC Yard, Gujarat' %>')">
            <i class="fa-solid fa-qrcode me-1"></i> QR Passport
          </button>
        </div>
        <div class="small text-secondary pt-1 border-top border-success-subtle">

          <div><i class="fa-solid fa-id-card me-1"></i> <strong>APMC License:</strong> <%= (product.supplier && product.supplier.mandiLicense) ? product.supplier.mandiLicense : 'APMC-GJ-2024-8841' %></div>
          <div><i class="fa-solid fa-shield-halved me-1"></i> <strong>FSSAI Lic:</strong> <%= (product.supplier && product.supplier.fssaiNumber) ? product.supplier.fssaiNumber : '10020021000142' %></div>
        </div>
      </div>
    </div>

    <!-- RIGHT CONTENT -->
    <div class="jd-view-content">
      <div class="d-flex align-items-center gap-2 mb-2 flex-wrap">
        <span class="badge bg-success-subtle text-success border border-success-subtle px-2 py-1"><%= product.category %></span>
        <span class="badge bg-secondary-subtle text-secondary border px-2 py-1">MOQ: <%= product.moq || 1 %> Quintal</span>
        <span class="mandi-trend-pill">
          <i class="fa-solid fa-circle-check"></i> Mandi Verified Rate
        </span>
      </div>

      <div class="d-flex align-items-center justify-content-between mb-2">
        <h1 class="jd-title mb-0"><%= product.name %></h1>
        <button type="button" class="btn btn-sm btn-outline-secondary rounded-pill px-3 fw-semibold shadow-sm" onclick="shareProduct('<%= product.name.replace(/'/g, "\\'") %>')" title="Share this crop lot">
          <i class="fa-solid fa-share-nodes me-1 text-success"></i> Share Lot
        </button>
      </div>

      <!-- 2. HIGH-TRUST CROP QUALITY & FRESHNESS BADGES -->
      <div class="quality-badges-row mb-3">
        <span class="quality-chip quality-chip-grade" onclick="openCropInspection('<%= product.name.replace(/'/g, "\\'") %>', '<%= product.grade %>', '<%= product.category %>', '11.8%', '<%= (product.supplier && product.supplier.name) ? product.supplier.name.replace(/'/g, "\\'") : 'APMC Mandi Farmer' %>')" title="Click for Quality Report">
          <i class="fa-solid fa-medal"></i> Grade <%= product.grade %> High Purity
        </span>
        <span class="quality-chip quality-chip-fresh" onclick="openCropInspection('<%= product.name.replace(/'/g, "\\'") %>', '<%= product.grade %>', '<%= product.category %>', '11.8%', '<%= (product.supplier && product.supplier.name) ? product.supplier.name.replace(/'/g, "\\'") : 'APMC Mandi Farmer' %>')" title="Harvested this week">
          <i class="fa-solid fa-bolt text-warning"></i> Fresh Harvest (&lt;24h)
        </span>
        <span class="quality-chip quality-chip-moisture" onclick="openCropInspection('<%= product.name.replace(/'/g, "\\'") %>', '<%= product.grade %>', '<%= product.category %>', '11.8%', '<%= (product.supplier && product.supplier.name) ? product.supplier.name.replace(/'/g, "\\'") : 'APMC Mandi Farmer' %>')" title="Moisture level verified">
          <i class="fa-solid fa-droplet text-info"></i> 11.8% Moisture Verified
        </span>
        <% if (product.supplier && product.supplier.organicCertified) { %>
          <span class="quality-chip quality-chip-organic" onclick="openCropInspection('<%= product.name.replace(/'/g, "\\'") %>', '<%= product.grade %>', '<%= product.category %>', '11.8%', '<%= (product.supplier && product.supplier.name) ? product.supplier.name.replace(/'/g, "\\'") : 'APMC Mandi Farmer' %>')">
            <i class="fa-solid fa-leaf"></i> NPOP Organic
          </span>
        <% } %>
      </div>

      <!-- PRICE CARD -->
      <div class="jd-price-card p-3 rounded-3 mb-3">
        <div class="jd-price-main fs-2 fw-bold text-success">
          ₹<%= (product.pricePerQuintal / 100).toFixed(2) %>
          <span class="fs-6 text-muted fw-normal">/ quintal (₹<%= (product.pricePerQuintal / 10000).toFixed(2) %>/kg)</span>
        </div>

        <% if (product.oldPrice > product.pricePerQuintal) { %>
          <div class="jd-market-row mt-1">
            Mandi Benchmark:
            <span class="jd-old text-decoration-line-through text-muted ms-1">
              ₹<%= (product.oldPrice / 100).toFixed(2) %>
            </span>
            <span class="jd-save text-success ms-2 fw-semibold">
              Save ₹<%= ((product.oldPrice - product.pricePerQuintal) / 100).toFixed(2) %>/q
            </span>
          </div>
        <% } %>
      </div>

      <!-- TIERED WHOLESALE DISCOUNT TABLE -->
      <div class="mb-3">
        <h6 class="fw-bold mb-2"><i class="fa-solid fa-tags text-warning me-1"></i> Wholesale Tiered Discounts</h6>
        <div class="table-responsive">
          <table class="table table-bordered table-sm tiered-table mb-1">
            <thead>
              <tr>
                <th>Order Quantity</th>
                <th>Volume Discount</th>
                <th>Effective Rate</th>
              </tr>
            </thead>
            <tbody>
              <tr>
                <td>1 - 9 Quintals</td>
                <td>Standard Rate</td>
                <td>₹<%= (product.pricePerQuintal / 100).toFixed(2) %>/q</td>
              </tr>
              <tr>
                <td>10 - 24 Quintals</td>
                <td><span class="discount-pill">5% OFF</span></td>
                <td class="text-success fw-bold">₹<%= ((product.pricePerQuintal * 0.95) / 100).toFixed(2) %>/q</td>
              </tr>
              <tr>
                <td>25+ Quintals</td>
                <td><span class="discount-pill">10% OFF</span></td>
                <td class="text-success fw-bold">₹<%= ((product.pricePerQuintal * 0.90) / 100).toFixed(2) %>/q</td>
              </tr>
            </tbody>
          </table>
        </div>
      </div>

      <!-- DESCRIPTION -->
      <div class="jd-section mb-3">
        <h6 class="fw-bold">Description</h6>
        <p class="text-muted small mb-0"><%= product.description || 'High quality harvest sourced directly from certified APMC farmers, tested for moisture, grain size, and purity.' %></p>
      </div>

      <!-- INFO CARDS -->
      <div class="jd-info-grid mb-3">
        <div class="jd-info-card">
          <i class="fa-solid fa-boxes-stacked text-success"></i>
          <div>
            <small class="text-muted d-block">Available Stock</small>
            <% 
              const actualAvailable = (product.available - (product.reserved || 0));
            %>
            <strong><%= Math.max(0, actualAvailable) %> Quintals</strong>
            <% if (actualAvailable <= 0) { %>
              <span class="badge bg-danger ms-1">Out of Stock</span>
            <% } else if (actualAvailable <= 5) { %>
              <span class="badge bg-warning text-dark pulse-badge ms-1">
                <i class="fa-solid fa-fire text-danger"></i> Low Stock (<%= actualAvailable %> Qtl)
              </span>
            <% } %>
          </div>
        </div>

        <div class="jd-info-card">
          <i class="fa-regular fa-truck text-success"></i>
          <div>
            <small class="text-muted d-block">Mandi Dispatch</small>
            <strong>
              <%= product.deliveryTime ? product.deliveryTime.minDays : 2 %>-<%= product.deliveryTime ? product.deliveryTime.maxDays : 7 %> Business Days
            </strong>
            <div id="dynamicDeliveryEstimate" data-min-days="<%= product.deliveryTime ? product.deliveryTime.minDays : 2 %>" data-max-days="<%= product.deliveryTime ? product.deliveryTime.maxDays : 5 %>" class="small mt-1"></div>
          </div>
        </div>
      </div>

      <!-- 1. INTERACTIVE BULK VOLUME, TIERED PRICING & LOGISTICS ESTIMATOR -->
      <div class="bulk-calculator-card">
        <div class="d-flex justify-content-between align-items-center mb-2">
          <h6 class="fw-bold mb-0 text-dark">
            <i class="fa-solid fa-calculator text-success me-1"></i> Interactive Bulk Volume & Logistics Calculator
          </h6>
          <span id="tierDiscountBadge" class="badge bg-success d-none">0% Tier Discount Applied</span>
        </div>

        <!-- Volume Slider & Stepper -->
        <div class="calc-slider-container">
          <div class="d-flex justify-content-between align-items-center mb-1">
            <span class="small fw-semibold text-muted">Volume (Quintals): <strong class="text-success fs-6" id="sliderValLabel">1 Qtl</strong></span>
            <span class="small text-muted">(1 Qtl = 100 kg)</span>
          </div>
          <input 
            type="range" 
            class="calc-slider" 
            id="volumeSlider" 
            min="<%= product.moq || 1 %>" 
            max="<%= Math.max(50, actualAvailable) %>" 
            value="<%= product.moq || 1 %>" 
            oninput="syncSliderToInput(this.value)"
          >
          <div class="d-flex justify-content-between text-muted" style="font-size: 0.72rem;">
            <span>MOQ: <%= product.moq || 1 %> Qtl</span>
            <span>25 Qtl (10% Tier)</span>
            <span><%= Math.max(50, actualAvailable) %> Qtl</span>
          </div>
        </div>

        <!-- Volume Preset Quick Chips -->
        <div class="jd-volume-chips mb-3">
          <span class="jd-volume-chip active" onclick="setVolumePreset(1, this)">1 Qtl <small class="text-muted">(Sample)</small></span>
          <span class="jd-volume-chip" onclick="setVolumePreset(10, this)">10 Qtl <span class="chip-badge">5% OFF</span></span>
          <span class="jd-volume-chip" onclick="setVolumePreset(25, this)">25 Qtl <span class="chip-badge">10% OFF</span></span>
          <span class="jd-volume-chip" onclick="setVolumePreset(50, this)">50 Qtl <span class="chip-badge">Bulk 10-T</span></span>
        </div>

        <!-- Logistics Freight Mode Preference -->
        <div class="mb-3">
          <label class="form-label fw-bold small text-dark mb-1">Delivery / Logistics Mode</label>
          <div class="d-flex gap-2">
            <button type="button" class="btn btn-sm btn-outline-success active flex-grow-1" id="modeDoorstepBtn" onclick="setLogisticsMode('doorstep')">
              <i class="fa-solid fa-truck me-1"></i> Doorstep Freight (₹45/Qtl)
            </button>
            <button type="button" class="btn btn-sm btn-outline-secondary flex-grow-1" id="modePickupBtn" onclick="setLogisticsMode('pickup')">
              <i class="fa-solid fa-warehouse me-1"></i> Ex-Mandi Yard Pickup (₹0)
            </button>
          </div>
        </div>

        <!-- Truckload Fill Utilization Meter -->
        <div class="mb-3 p-2 bg-white rounded-3 border">
          <div class="d-flex justify-content-between align-items-center mb-1">
            <span class="small fw-semibold text-muted"><i class="fa-solid fa-truck-moving text-success me-1"></i> Standard 10-Tonner Truck Utilization:</span>
            <span class="small fw-bold text-success" id="truckUtilizationPercent">1%</span>
          </div>
          <div class="truck-fill-meter">
            <div class="truck-fill-bar" id="truckFillBar" style="width: 1%;"></div>
          </div>
          <small class="text-muted d-block mt-1" style="font-size: 0.72rem;" id="truckCapacityAdvice">Orders above 50 Qtl maximize freight economics per quintal.</small>
        </div>

        <div class="jd-stepper mb-3">
          <button type="button" class="jd-step btn btn-outline-secondary" id="minusBtn">−</button>
          <input type="number" id="qtyInput" value="<%= product.moq || 1 %>" min="<%= product.moq || 1 %>" max="<%= Math.max(1, actualAvailable) %>" class="form-control text-center fw-bold" style="max-width: 120px;" />
          <button type="button" class="jd-step btn btn-outline-secondary" id="plusBtn">+</button>
        </div>

        <!-- Live Calculation Breakdown Box -->
        <div class="calc-breakdown-box">
          <div class="d-flex justify-content-between mb-1">
            <span class="text-muted">Effective Base Rate:</span>
            <strong class="text-dark" id="displayUnitRate">₹<%= (product.pricePerQuintal / 100).toFixed(2) %>/q</strong>
          </div>
          <div class="d-flex justify-content-between mb-1">
            <span class="text-muted">Estimated Freight:</span>
            <span class="text-secondary" id="displayFreight">₹45.00</span>
          </div>
          <div class="d-flex justify-content-between mb-1">
            <span class="text-muted">Mandi Cess & GST (5%):</span>
            <span class="text-secondary" id="displayGst">₹<%= ((product.pricePerQuintal * 0.05) / 100).toFixed(2) %></span>
          </div>
          <div class="d-flex justify-content-between border-top pt-2 mt-1">
            <span class="fw-bold text-dark fs-6">Estimated Order Total:</span>
            <strong class="fs-4 text-success" id="displayTotal">₹<%= (product.pricePerQuintal / 100).toFixed(2) %></strong>
          </div>
          <small id="savingsText" class="text-success fw-semibold d-block mt-1"></small>
        </div>

        <div class="jd-actions d-flex gap-2 mt-3">
          <form action="/cart/add/<%= product._id %>" method="POST" class="flex-grow-1" id="cartForm">
            <input type="hidden" name="quantity" id="cartQty" value="<%= product.moq || 1 %>">
            <button class="btn btn-3d btn-3d-secondary w-100 py-2.5 fw-semibold" type="submit" onclick="animateCartIcon()">
              <i class="fa-solid fa-cart-plus me-1 text-success"></i> Add to Cart
            </button>
          </form>

          <form action="/orders/buy-now/<%= product._id %>" method="POST" class="flex-grow-1" id="buyForm">
            <input type="hidden" name="quantity" id="buyQty" value="<%= product.moq || 1 %>">
            <button class="btn btn-3d btn-3d-success w-100 py-2.5 fw-semibold" type="submit">
              <i class="fa-solid fa-bolt me-1"></i> Buy Wholesale Now
            </button>
          </form>
        </div>
      </div>

      <!-- 3. B2B WHOLESALE SLIDE-OUT RFQ CTA BOX -->
      <div class="rfq-box text-center">
        <h6 class="fw-bold text-dark mb-1"><i class="fa-solid fa-handshake text-success me-1"></i> Need Large Wholesale Volume?</h6>
        <p class="small text-muted mb-2">Buying >50 quintals or need custom contract terms? Submit a Request for Quote (RFQ) to negotiate with suppliers.</p>
        <button type="button" class="btn btn-sm btn-dark px-3 py-2 fw-semibold" onclick="openRfqDrawer('<%= product._id %>', '<%= product.name.replace(/'/g, "\\'") %>', <%= (product.pricePerQuintal / 100) %>, '<%= (product.supplier && product.supplier.location) ? product.supplier.location.replace(/'/g, "\\'") : 'APMC Mandi' %>')">
          <i class="fa-solid fa-sliders me-1"></i> Open Instant RFQ Drawer
        </button>
      </div>

    </div>
  </div>
</div>

<!-- 5. MOBILE STICKY PRODUCT ACTION BAR -->
<div class="jd-mobile-action-bar">
  <div>
    <small class="text-muted d-block" style="font-size: 0.72rem;">Total Price</small>
    <strong class="text-success fs-6" id="mobileStickyTotal">₹<%= (product.pricePerQuintal / 100).toFixed(2) %></strong>
  </div>
  <button type="button" class="btn btn-sm btn-outline-dark fw-semibold" onclick="openRfqDrawer('<%= product._id %>', '<%= product.name.replace(/'/g, "\\'") %>', <%= (product.pricePerQuintal / 100) %>, '<%= (product.supplier && product.supplier.location) ? product.supplier.location.replace(/'/g, "\\'") : 'APMC Mandi' %>')">
    <i class="fa-solid fa-handshake me-1"></i> RFQ
  </button>
  <button type="button" class="btn btn-sm btn-success flex-grow-1 fw-bold" onclick="document.getElementById('buyForm').submit()">
    <i class="fa-solid fa-bolt me-1"></i> Buy Now
  </button>
</div>

<%- include("partials/footer") %>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js"></script>
<script src="/js/product-3d-viewer.js"></script>
<script>
  const basePricePerQuintal = <%= product.pricePerQuintal %> / 100; // in Rupees
  const moq = <%= product.moq || 1 %>;
  const maxAvailable = <%= Math.max(1, actualAvailable) %>;
  let currentLogisticsMode = 'doorstep';
  const freightPerQuintal = 45; // Rs 45/Qtl for doorstep delivery
  let viewer3DInstance = null;

  function switchMediaView(viewType) {
    const tab2D = document.getElementById("tabMedia2D");
    const tab3D = document.getElementById("tabMedia3D");
    const media2DWrapper = document.getElementById("media2DWrapper");
    const product3DStage = document.getElementById("product3DStage");

    if (viewType === '3d') {
      tab3D.classList.add("active");
      tab2D.classList.remove("active");
      media2DWrapper.classList.add("d-none");
      product3DStage.classList.remove("d-none");

      if (!viewer3DInstance) {
        viewer3DInstance = window.initProduct3DViewer("product3DStage", {
          cropName: "<%= product.name.replace(/'/g, "\\'") %>",
          category: "<%= product.category %>",
          grade: "<%= product.grade %>",
          autoRotate: true
        });
      }
    } else {
      tab2D.classList.add("active");
      tab3D.classList.remove("active");
      media2DWrapper.classList.remove("d-none");
      product3DStage.classList.add("d-none");
    }
  }

  function setLogisticsMode(mode) {
    currentLogisticsMode = mode;
    const doorstepBtn = document.getElementById('modeDoorstepBtn');
    const pickupBtn = document.getElementById('modePickupBtn');
    if (mode === 'doorstep') {
      doorstepBtn.classList.add('btn-outline-success', 'active');
      doorstepBtn.classList.remove('btn-outline-secondary');
      pickupBtn.classList.add('btn-outline-secondary');
      pickupBtn.classList.remove('btn-outline-success', 'active');
    } else {
      pickupBtn.classList.add('btn-outline-success', 'active');
      pickupBtn.classList.remove('btn-outline-secondary');
      doorstepBtn.classList.add('btn-outline-secondary');
      doorstepBtn.classList.remove('btn-outline-success', 'active');
    }
    updatePricing();
  }

  function syncSliderToInput(val) {
    const qtyInput = document.getElementById('qtyInput');
    if (qtyInput) {
      qtyInput.value = val;
      updatePricing();
    }
  }

  function setVolumePreset(volume, elem) {
    document.querySelectorAll('.jd-volume-chip').forEach(c => c.classList.remove('active'));
    if (elem) elem.classList.add('active');
    const input = document.getElementById('qtyInput');
    const slider = document.getElementById('volumeSlider');
    if (input) {
      input.value = Math.min(volume, maxAvailable);
      if (slider) slider.value = input.value;
      updatePricing();
    }
  }

  function calculateDiscount(qty) {
    if (qty >= 25) return 10;
    if (qty >= 10) return 5;
    return 0;
  }

  function updatePricing() {
    const qtyInput = document.getElementById('qtyInput');
    const volumeSlider = document.getElementById('volumeSlider');
    const sliderValLabel = document.getElementById('sliderValLabel');
    const cartQtyInput = document.getElementById('cartQty');
    const buyQtyInput = document.getElementById('buyQty');
    const displayTotal = document.getElementById('displayTotal');
    const displayUnitRate = document.getElementById('displayUnitRate');
    const displayFreight = document.getElementById('displayFreight');
    const displayGst = document.getElementById('displayGst');
    const mobileStickyTotal = document.getElementById('mobileStickyTotal');
    const tierBadge = document.getElementById('tierDiscountBadge');
    const savingsText = document.getElementById('savingsText');
    const truckFillBar = document.getElementById('truckFillBar');
    const truckUtilText = document.getElementById('truckUtilizationPercent');

    let qty = parseInt(qtyInput.value, 10);
    if (isNaN(qty) || qty < moq) qty = moq;
    if (qty > maxAvailable) qty = maxAvailable;
    qtyInput.value = qty;
    if (volumeSlider) volumeSlider.value = qty;
    if (sliderValLabel) sliderValLabel.textContent = `${qty} Qtl (${qty * 100} kg)`;
    if (cartQtyInput) cartQtyInput.value = qty;
    if (buyQtyInput) buyQtyInput.value = qty;

    const discountPercent = calculateDiscount(qty);
    const discountedRate = basePricePerQuintal * (1 - discountPercent / 100);
    const subtotal = qty * discountedRate;
    const freight = currentLogisticsMode === 'doorstep' ? qty * freightPerQuintal : 0;
    const gst = (subtotal + freight) * 0.05;
    const total = subtotal + freight + gst;
    const originalTotal = (qty * basePricePerQuintal) * 1.05 + freight;
    const savings = originalTotal - total;

    // Truckload utilization (100 Qtl = 10-ton full truckload)
    const truckPercent = Math.min(100, Math.round((qty / 100) * 100));
    if (truckFillBar) truckFillBar.style.width = `${truckPercent}%`;
    if (truckUtilText) truckUtilText.textContent = `${truckPercent}% (${qty}/100 Qtl)`;

    if (displayUnitRate) displayUnitRate.textContent = '₹' + discountedRate.toFixed(2) + '/q';
    if (displayFreight) displayFreight.textContent = currentLogisticsMode === 'doorstep' ? '₹' + freight.toFixed(2) : '₹0.00 (Ex-Mandi)';
    if (displayGst) displayGst.textContent = '₹' + gst.toFixed(2);
    if (displayTotal) displayTotal.textContent = '₹' + total.toLocaleString('en-IN', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
    if (mobileStickyTotal) mobileStickyTotal.textContent = '₹' + total.toLocaleString('en-IN', { minimumFractionDigits: 2, maximumFractionDigits: 2 });

    if (discountPercent > 0) {
      if (tierBadge) {
        tierBadge.textContent = `${discountPercent}% Volume Discount Active`;
        tierBadge.classList.remove('d-none');
      }
      if (savingsText) savingsText.textContent = `You save ₹${savings.toFixed(2)} with wholesale volume tiers!`;
    } else {
      if (tierBadge) tierBadge.classList.add('d-none');
      if (savingsText) savingsText.textContent = '';
    }
  }

  document.addEventListener('DOMContentLoaded', function() {
    const minusBtn = document.getElementById('minusBtn');
    const plusBtn = document.getElementById('plusBtn');
    const qtyInput = document.getElementById('qtyInput');

    if (minusBtn) {
      minusBtn.addEventListener('click', (e) => {
        e.preventDefault();
        let qty = parseInt(qtyInput.value, 10) || moq;
        if (qty > moq) {
          qtyInput.value = qty - 1;
          updatePricing();
        }
      });
    }

    if (plusBtn) {
      plusBtn.addEventListener('click', (e) => {
        e.preventDefault();
        let qty = parseInt(qtyInput.value, 10) || moq;
        if (qty < maxAvailable) {
          qtyInput.value = qty + 1;
          updatePricing();
        }
      });
    }

    if (qtyInput) {
      qtyInput.addEventListener('input', updatePricing);
    }

    updatePricing();
  });
</script>
</body>
</html>


