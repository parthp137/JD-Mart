<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <title>JD Mart | Forgot Password</title>

  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/forgot-password.css">
</head>
<body>

<div class="container">

  <!-- LEFT PANEL -->
  <div class="left-panel">
    <div class="brand">
      <div class="logo">🍃</div>
      <div>
        <h3>JD Mart</h3>
        <span>Buyer Portal</span>
      </div>
    </div>

    <h1>
      Secure Access to<br>
      Your JD Mart Account
    </h1>

    <p>
      Reset your password securely and get back to sourcing premium crops from verified farmers.
    </p>

    <ul class="features">
      <li>✔ OTP-based verification</li>
      <li>✔ Encrypted password reset</li>
      <li>✔ Secure account recovery</li>
      <li>✔ 24/7 support</li>
    </ul>
  </div>

  <!-- RIGHT PANEL -->
  <div class="right-panel">

    <div class="top-bar">
      <a href="/login">← Back to Login</a>
    </div>

    <% if (step === "reset") { %>
      <h2>Reset Password</h2>
      <p class="subtitle">Create a new password for your account</p>
    <% } else { %>
      <h2>Forgot Password</h2>
      <p class="subtitle">We’ll help you reset your account access</p>
    <% } %>

    <% if (typeof error !== 'undefined' && error) { %>
      <div class="alert alert-danger" style="margin-bottom:16px;">
        <%= error %>
      </div>
    <% } %>

    <% if (typeof message !== 'undefined' && message) { %>
      <div class="alert alert-success" style="margin-bottom:16px;">
        <%= message %>
      </div>
    <% } %>

    <% if (step === "reset") { %>
      <form action="/reset-password/<%= token %>" method="POST">
        <div class="input-group">
          <label>New Password</label>
          <input
            type="password"
            name="password"
            placeholder="Enter a new password"
            required
          />
        </div>

        <div class="input-group">
          <label>Confirm Password</label>
          <input
            type="password"
            name="confirm"
            placeholder="Repeat the new password"
            required
          />
        </div>

        <button class="btn" type="submit">
          Update Password →
        </button>
      </form>
    <% } else { %>
      <form action="/forgot-password" method="POST">

      <div class="input-group">
        <label>Email or Phone</label>
        <input 
          type="text" 
          name="login" 
          placeholder="Enter your email or phone"
          required
        />
      </div>

      <button class="btn" type="submit">
        Send Reset Link →
      </button>

      </form>
    <% } %>

    <div class="helper-box">
      <strong>How it works</strong>
      <p>
        <% if (step === "reset") { %>
          Enter and confirm your new password to regain access.
        <% } else { %>
          We'll generate a secure reset token and take you to the password reset screen.
        <% } %>
      </p>
    </div>

    <p class="login-link">
      Remembered your password?
      <a href="/login">Sign In</a>
    </p>

  </div>

</div>

</body>
</html>
