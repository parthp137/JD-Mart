<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>JD Mart</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-sRIl4kxILFvY47J16cr9ZwB07vP4J8+LH7qKQnuqkuIAvNWLzeN8tE5YBujZqJLB" crossorigin="anonymous">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/7.0.1/css/all.min.css">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
   
    <link rel="stylesheet" href="/css/style.css">
</head>
<body>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js" integrity="sha384-7+zCNj/IqJ95wo16oMtfsKbZ9ccEh31eOz1HGyDuCQ6wgnyJNSYdrPa03rtR1zdB" crossorigin="anonymous"></script>

<%- include("partials/header") %>
    
<!-- Premium Buyer Section with 3D Canvas -->
<div class="premium-section container-fluid my-4 p-4 shadow-sm" data-tilt-3d="true">
  <div class="row align-items-center">
    
    <!-- Left + Stats -->
    <div class="col-12">

      <!-- 3D Mandi Badge & Text Info -->
      <div class="d-flex align-items-center gap-2 mb-2 flex-wrap">
        <span class="fw-bold d-inline-flex align-items-center gap-1 text-success">
          <i class="fa-regular fa-star"></i> Premium Buyer
        </span>
        <span class="badge bg-success-subtle text-success border border-success-subtle px-2.5 py-1 rounded-pill small">
          <i class="fa-solid fa-cube me-1"></i> Interactive 3D Mandi Floor
        </span>
      </div>

      <h3 class="mb-1 fw-bold text-dark">Fresh Crops, Direct from APMC Farms</h3>
      <p class="text-muted mb-0">Browse our selection of quality-verified crops with 3D lot inspection at competitive mandi rates.</p>

      <!-- Stats Below -->
      <div class="d-flex flex-wrap gap-4 mt-3">

        <div class="d-flex align-items-center gap-2 premium-stat">
          <i class="fa-solid fa-box"></i>
          <span><%= typeof allProducts !== 'undefined' ? allProducts.length : 7 %> Verified Products</span>
        </div>

        <div class="d-flex align-items-center gap-2 premium-stat">
          <i class="fa-regular fa-truck"></i>
          <span>1-4 Days Doorstep Delivery</span>
        </div>

        <div class="d-flex align-items-center gap-2 premium-stat">
          <i class="fa-solid fa-shield-halved"></i>
          <span>100% Escrow Protected</span>
        </div>

      </div>
    </div>

  </div>
</div>


<!-- DASHBOARD STATISTICS -->

  <div class="row row-cols-lg-4 row-cols-md-3 row-cols-sm-1 gx-4 px-4">

    <!-- Categories -->
    <div class="col-md-3 col-sm-6">
      <div class="stat-card d-flex align-items-center p-3">
        <div class="stat-icon me-3">
          <i class="fa-solid fa-leaf"></i>
        </div>
        <div>
          <h4 class="mb-1"><%= dashboardStats.totalCategories?.[0]?.count || 0 %></h4>
          <p class="mb-0 text-muted">Categories</p>
        </div>
      </div>
    </div>

    <!-- Products In Stock -->
    <div class="col-md-3 col-sm-6">
      <div class="stat-card d-flex align-items-center p-3">
        <div class="stat-icon me-3" style="background-color: rgba(245,158,11,0.1);">
          <i class="fa-solid fa-cube" style="color: #f59e0b;"></i>
        </div>
        <div>
          <h4 class="mb-1"><%= dashboardStats.inStock?.[0]?.count || 0 %></h4>
          <p class="mb-0 text-muted">Products In Stock</p>
        </div>
      </div>
    </div>

    <!-- Below Market -->
    <div class="col-md-3 col-sm-6">
      <div class="stat-card d-flex align-items-center p-3">
        <div class="stat-icon me-3" style="background-color: rgba(239,68,68,0.1);">
          <i class="fa-solid fa-arrow-trend-down" style="color: #ef4444;"></i>
        </div>
        <div>
          <h4 class="mb-1"><%= dashboardStats.belowMarket?.[0]?.count || 0 %></h4>
          <p class="mb-0 text-muted">Below Market</p>
        </div>
      </div>
    </div>

    <!-- Grade A Products -->
    <div class="col-md-3 col-sm-6">
      <div class="stat-card d-flex align-items-center p-3">
        <div class="stat-icon me-3" style="background-color: rgba(59,130,246,0.1);">
          <i class="fa-regular fa-star" style="color: #3b82f6;"></i>
        </div>
        <div>
          <h4 class="mb-1"><%= dashboardStats.gradeA?.[0]?.count || 0 %></h4>
          <p class="mb-0 text-muted">Grade A Products</p>
        </div>
      </div>
    </div>

  </div>



<!-- Advanced Filters -->
<div class="mb-3 mt-4 m-4" style="background: var(--jd-bg-surface); padding: 1.5rem; border-radius: 0.75rem; border: 1px solid var(--jd-border-color);">
  <form id="filterForm" method="GET" action="/products">
    <div class="row g-3">
      <!-- Category Filters -->
      <div class="col-lg-3">
        <h6 style="font-weight: 600; margin-bottom: 0.75rem;">
          <i class="fa-solid fa-tag"></i> Category
        </h6>
        <div class="category-filters" style="display: flex; gap: 0.5rem; flex-wrap: wrap;">
          <button type="button" class="cat-btn <%= !category || category === 'all' ? 'active' : '' %>" data-category="all" onclick="filterByCategory('all')">All</button>
          <button type="button" class="cat-btn <%= category === 'Grains' ? 'active' : '' %>" data-category="Grains" onclick="filterByCategory('Grains')">Grains</button>
          <button type="button" class="cat-btn <%= category === 'Pulses' ? 'active' : '' %>" data-category="Pulses" onclick="filterByCategory('Pulses')">Pulses</button>
          <button type="button" class="cat-btn <%= category === 'Oilseeds' ? 'active' : '' %>" data-category="Oilseeds" onclick="filterByCategory('Oilseeds')">Oilseeds</button>
          <button type="button" class="cat-btn <%= category === 'Spices' ? 'active' : '' %>" data-category="Spices" onclick="filterByCategory('Spices')">Spices</button>
        </div>
      </div>

      <!-- Price Range -->
      <div class="col-lg-2">
        <h6 style="font-weight: 600; margin-bottom: 0.75rem;">
          <i class="fa-solid fa-indian-rupee-sign"></i> Price Range
        </h6>
        <div>
          <label style="font-size: 0.875rem; margin-bottom: 0.5rem;">Min (₹/kg)</label>
          <input type="number" name="priceMin" id="priceMin" class="form-control form-control-sm" value="<%= priceMin || '' %>" placeholder="Min">
          <label style="font-size: 0.875rem; margin-top: 0.5rem; margin-bottom: 0.5rem;">Max (₹/kg)</label>
          <input type="number" name="priceMax" id="priceMax" class="form-control form-control-sm" value="<%= priceMax || '' %>" placeholder="Max">
        </div>
      </div>

      <!-- Grade -->
      <div class="col-lg-2">
        <h6 style="font-weight: 600; margin-bottom: 0.75rem;">
          <i class="fa-solid fa-star"></i> Grade
        </h6>
        <select name="grade" id="gradeFilter" class="form-select form-select-sm">
          <option value="">All Grades</option>
          <option value="A" <%= grade === 'A' ? 'selected' : '' %>>Grade A</option>
          <option value="B" <%= grade === 'B' ? 'selected' : '' %>>Grade B</option>
          <option value="C" <%= grade === 'C' ? 'selected' : '' %>>Grade C</option>
        </select>
      </div>

      <!-- Availability -->
      <div class="col-lg-2">
        <h6 style="font-weight: 600; margin-bottom: 0.75rem;">
          <i class="fa-solid fa-box"></i> Stock
        </h6>
        <select name="availability" id="availabilityFilter" class="form-select form-select-sm">
          <option value="">All</option>
          <option value="in-stock" <%= availability === 'in-stock' ? 'selected' : '' %>>In Stock</option>
          <option value="low-stock" <%= availability === 'low-stock' ? 'selected' : '' %>>Low Stock</option>
        </select>
      </div>

      <!-- Action Buttons -->
      <div class="col-lg-3 d-flex align-items-end gap-2">
        <button type="submit" class="btn btn-sm btn-3d btn-3d-success" style="flex: 1;">
          <i class="fa-solid fa-filter me-1"></i> Apply Filters
        </button>
        <a href="/products" class="btn btn-sm btn-3d btn-3d-secondary" style="flex: 1;">
          <i class="fa-solid fa-redo me-1"></i> Reset
        </a>
      </div>
    </div>

    <!-- Hidden inputs for search -->
    <input type="hidden" name="search" value="<%= search || '' %>">
    <input type="hidden" id="categoryInput" name="category" value="<%= category || '' %>">
  </form>
</div>

<!-- ACTIVE FILTER PILLS (Dynamic) -->
<div class="container-fluid px-4" id="activeFilterSection">
  <% 
    const hasActiveFilters = (category && category !== 'all') || grade || availability || priceMin || priceMax || search;
    if (hasActiveFilters) { 
  %>
    <div class="active-filters-bar shadow-sm">
      <span class="small fw-bold text-success me-1"><i class="fa-solid fa-sliders me-1"></i> Active Filters:</span>
      <% if (category && category !== 'all') { %>
        <span class="filter-chip">
          <i class="fa-solid fa-tag text-xs text-muted"></i> Category: <strong><%= category %></strong>
          <span class="filter-chip-remove" onclick="clearFilter('category')" title="Remove filter">✕</span>
        </span>
      <% } %>
      <% if (grade) { %>
        <span class="filter-chip">
          <i class="fa-solid fa-star text-xs text-warning"></i> Grade: <strong><%= grade %></strong>
          <span class="filter-chip-remove" onclick="clearFilter('grade')" title="Remove filter">✕</span>
        </span>
      <% } %>
      <% if (availability) { %>
        <span class="filter-chip">
          <i class="fa-solid fa-box text-xs text-primary"></i> Stock: <strong><%= availability === 'in-stock' ? 'In Stock' : 'Low Stock' %></strong>
          <span class="filter-chip-remove" onclick="clearFilter('availability')" title="Remove filter">✕</span>
        </span>
      <% } %>
      <% if (priceMin || priceMax) { %>
        <span class="filter-chip">
          <i class="fa-solid fa-indian-rupee-sign text-xs text-success"></i> Rate: <strong>₹<%= priceMin || '0' %> - ₹<%= priceMax || 'Any' %>/kg</strong>
          <span class="filter-chip-remove" onclick="clearFilter('price')" title="Remove filter">✕</span>
        </span>
      <% } %>
      <% if (search) { %>
        <span class="filter-chip">
          <i class="fa-solid fa-magnifying-glass text-xs text-info"></i> Search: <strong>"<%= search %>"</strong>
          <span class="filter-chip-remove" onclick="clearFilter('search')" title="Remove filter">✕</span>
        </span>
      <% } %>
      <a href="/products" class="btn-clear-filters ms-auto" title="Reset all search & filter parameters">
        <i class="fa-solid fa-xmark"></i> Clear All Filters
      </a>
    </div>
  <% } %>
</div>

<script>
  function filterByCategory(cat) {
    document.getElementById('categoryInput').value = cat === 'all' ? '' : cat;
    document.getElementById('filterForm').submit();
  }

  function clearFilter(filterType) {
    const url = new URL(window.location.href);
    if (filterType === 'price') {
      url.searchParams.delete('priceMin');
      url.searchParams.delete('priceMax');
    } else {
      url.searchParams.delete(filterType);
    }
    url.searchParams.set('page', '1');
    window.location.href = url.toString();
  }
</script>

<% if (typeof error !== 'undefined' && error) { %>
  <div class="container-fluid px-4">
    <div class="alert alert-danger"><%= error %></div>
  </div>
<% } %>

<% if (typeof message !== 'undefined' && message) { %>
  <div class="container-fluid px-4">
    <div class="alert alert-success"><%= message %></div>
  </div>
<% } %>

    <!-- No Results State -->
    <% if (!allProducts || allProducts.length === 0) { %>
      <div class="container-fluid px-4" style="margin: 4rem 0;">
        <div style="text-align: center; padding: 3rem;">
          <i class="fa-solid fa-search" style="font-size: 4rem; color: #d1d5db; margin-bottom: 1rem;"></i>
          <h3 style="color: #6b7280; margin-bottom: 0.5rem;">No Products Found</h3>
          <p style="color: #9ca3af; margin-bottom: 1.5rem;">
            Try adjusting your filters or search terms
          </p>
          <a href="/products" class="btn btn-success">
            <i class="fa-solid fa-redo"></i> Clear Filters
          </a>
        </div>
      </div>
    <% } else { %>

    <!-- Product Cards -->
 <div class="row row-cols-lg-4 row-cols-md-3 row-cols-sm-1 gx-4 px-4 mb-6" id="productGrid">

    <% for(let product of allProducts){ %>
    <div class="col mb-4 product-card-col">
      <div class="jd-card h-100 d-flex flex-column">

        <!-- IMAGE -->
        <div class="jd-image position-relative">
          <!-- COMPARE CHECKBOX TRIGGER -->
          <label class="compare-checkbox-wrapper" onclick="event.stopPropagation();" title="Add to side-by-side comparison matrix">
            <input 
              type="checkbox" 
              class="compare-item-chk form-check-input mt-0" 
              data-id="<%= product._id %>"
              data-name="<%= product.name.replace(/"/g, '&quot;') %>"
              data-category="<%= product.category %>"
              data-grade="<%= product.grade %>"
              data-price="<%= (product.pricePerQuintal / 100).toFixed(2) %>"
              data-moisture="11.8%"
              data-purity="99.4%"
              data-supplier="<%= (product.supplier && product.supplier.name) ? product.supplier.name.replace(/"/g, '&quot;') : 'APMC Mandi Farmer' %>"
              data-location="<%= (product.supplier && product.supplier.location) ? product.supplier.location.replace(/"/g, '&quot;') : 'Gujarat Mandi' %>"
              data-delivery="<%= product.deliveryTime ? `${product.deliveryTime.minDays}-${product.deliveryTime.maxDays} days` : '1-4 days' %>"
              data-image="<%= getImageUrl(product.images) %>"
              onchange="handleCompareToggle(this)"
            >
            <span>Compare</span>
          </label>

          <a href="/products/<%= product._id %>" class="d-block">
            <img
              src="<%= getImageUrl(product.images) %>"
              alt="<%= product.name %>"
              class="jd-image-tag"
              onerror="this.onerror=null;this.src='<%= getCropPlaceholder(product.category || product.name) %>'"
            >
          </a>

          <!-- BADGES -->
          <div class="jd-badges">
            <span class="jd-grade <%= product.grade === 'A' ? 'grade-a' : (product.grade === 'B' ? 'grade-b' : '') %> quality-chip quality-chip-grade" onclick="event.stopPropagation(); openCropInspection('<%= product.name.replace(/'/g, "\\'") %>', '<%= product.grade %>', '<%= product.category %>', '11.8%', '<%= (product.supplier && product.supplier.name) ? product.supplier.name.replace(/'/g, "\\'") : 'APMC Mandi Farmer' %>')" title="Click to view lab certificate">
              <i class="fa-solid fa-certificate"></i> Grade <%= product.grade %>
            </span>

            <% if (product.belowMarketPercent > 0) { %>
              <span class="jd-market">
                <i class="fa-solid fa-arrow-trend-down"></i>
                <%= product.belowMarketPercent %>% below market
              </span>
            <% } %>

            <% 
              const actualAvailable = (product.available - (product.reserved || 0));
              if (actualAvailable <= 0) {
            %>
              <span class="badge bg-danger">
                <i class="fa-solid fa-exclamation-circle"></i> Out of Stock
              </span>
            <% } else if (actualAvailable <= 5) { %>
              <span class="badge bg-warning text-dark pulse-badge">
                <i class="fa-solid fa-fire text-danger"></i> Only <%= actualAvailable %> left
              </span>
            <% } %>
          </div>
        </div>

        <!-- BODY -->
        <div class="jd-body d-flex flex-column flex-grow-1">

          <div class="jd-meta">
            <span class="jd-category"><%= product.category.toUpperCase() %></span>
            <span class="jd-demand <%= product.demandLevel.toLowerCase() %>">
              <%= product.demandLevel %> Demand
            </span>
          </div>

          <h5 class="jd-product-name mb-1">
            <a href="/products/<%= product._id %>" class="text-decoration-none text-dark"><%= product.name %></a>
          </h5>

          <!-- MANDI BENCHMARK & QUALITY CHIPS -->
          <div class="quality-badges-row my-1 d-flex flex-wrap gap-1">
            <span class="quality-chip quality-chip-fresh" onclick="event.stopPropagation(); openCropInspection('<%= product.name.replace(/'/g, "\\'") %>', '<%= product.grade %>', '<%= product.category %>', '11.8%', '<%= (product.supplier && product.supplier.name) ? product.supplier.name.replace(/'/g, "\\'") : 'APMC Mandi Farmer' %>')">
              <i class="fa-solid fa-bolt text-warning"></i> Fresh
            </span>
            <span class="quality-chip quality-chip-moisture" onclick="event.stopPropagation(); openCropInspection('<%= product.name.replace(/'/g, "\\'") %>', '<%= product.grade %>', '<%= product.category %>', '11.8%', '<%= (product.supplier && product.supplier.name) ? product.supplier.name.replace(/'/g, "\\'") : 'APMC Mandi Farmer' %>')">
              <i class="fa-solid fa-droplet text-info"></i> 12% Moisture
            </span>
            <span class="traceability-badge" onclick="event.stopPropagation(); openTraceabilityPassport('<%= product.name.replace(/'/g, "\\'") %>', '<%= product.grade %>', '<%= product.category %>', '<%= (product.supplier && product.supplier.name) ? product.supplier.name.replace(/'/g, "\\'") : 'Patel Organic Farms' %>', '<%= (product.supplier && product.supplier.location) ? product.supplier.location.replace(/'/g, "\\'") : 'Unjha APMC Yard, Gujarat' %>')" title="View Farm Traceability & QR Passport">
              <i class="fa-solid fa-seedling"></i> Origin
            </span>
          </div>

          <!-- 7-DAY APMC PRICE TREND SPARKLINES -->
          <div class="d-flex align-items-center justify-content-between my-2">
            <div class="sparkline-container" data-sparkline-target="true" data-grade="<%= product.grade %>" title="7-day APMC Mandi price trajectory">
              <svg class="sparkline-svg" viewBox="0 0 58 18">
                <path d="M 2 14 L 11 11 L 20 13 L 30 8 L 40 10 L 49 5 L 56 4" fill="none" stroke="#16a34a" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                <circle cx="56" cy="4" r="2.5" fill="#16a34a"/>
              </svg>
              <span style="font-size: 0.72rem; font-weight: 700; color: #16a34a;">7D Trend</span>
            </div>
            <span class="small text-muted" style="font-size: 0.75rem;">APMC Verified</span>
          </div>

          <div class="jd-price mt-auto">
            <span class="jd-current">
              ₹<%= (product.pricePerQuintal / 100).toFixed(2) %>
            </span>
            <span class="jd-unit">/kg (₹<%= ((product.pricePerQuintal * 100) / 100).toFixed(0) %>/Qtl)</span>
            <% if (product.oldPrice > product.pricePerQuintal) { %>
              <span class="jd-old">
                ₹<%= (product.oldPrice / 100).toFixed(2) %>
              </span>
            <% } %>
          </div>

          <!-- Quick Action Buttons -->
          <div class="d-flex align-items-center gap-1.5 mt-2 pt-2 border-top">
            <a href="/products/<%= product._id %>" class="btn btn-sm btn-outline-success flex-grow-1 fw-semibold">
              <i class="fa-regular fa-eye me-1"></i> Details
            </a>
            <button type="button" class="btn btn-sm btn-light border flex-grow-1 fw-semibold text-secondary" onclick="openRfqDrawer('<%= product._id %>', '<%= product.name.replace(/'/g, "\\'") %>', <%= (product.pricePerQuintal / 100) %>, '<%= (product.supplier && product.supplier.location) ? product.supplier.location.replace(/'/g, "\\'") : 'APMC Mandi' %>')" title="Submit instant wholesale offer">
              <i class="fa-solid fa-handshake text-success me-1"></i> RFQ
            </button>
            <button type="button" class="price-alert-btn" onclick="openPriceAlertModal('<%= product._id %>', '<%= product.name.replace(/'/g, "\\'") %>', <%= (product.pricePerQuintal / 100) %>)" title="Set Mandi Target Price Alert">
              <i class="fa-solid fa-bell"></i>
            </button>
          </div>


          <div class="jd-footer mt-2 pt-1 border-top">
            <span>
              <i class="fa-solid fa-boxes-stacked text-success"></i>
              <%= product.available * 100 %> kg
            </span>
            <span>
              <i class="fa-regular fa-clock text-muted"></i>
              <%= product.deliveryTime ? product.deliveryTime.minDays : 1 %>-<%= product.deliveryTime ? product.deliveryTime.maxDays : 4 %> days
            </span>
          </div>

        </div>
      </div>
    </div>
    <% } %>
    </div>
    <% } %>

<% if (typeof totalPages !== 'undefined' && totalPages > 1) { %>
  <div class="container-fluid px-4 mb-5">
    <nav aria-label="Product pagination">
      <ul class="pagination justify-content-center mt-3">
        <li class="page-item <%= page <= 1 ? 'disabled' : '' %>">
          <a class="page-link" href="/products?page=<%= Math.max(1, page - 1) %><%= search ? `&search=${encodeURIComponent(search)}` : '' %><%= category ? `&category=${encodeURIComponent(category)}` : '' %><%= priceMin ? `&priceMin=${priceMin}` : '' %><%= priceMax ? `&priceMax=${priceMax}` : '' %><%= grade ? `&grade=${grade}` : '' %><%= availability ? `&availability=${availability}` : '' %>">Previous</a>
        </li>
        <li class="page-item disabled"><span class="page-link">Page <%= page %> of <%= totalPages %></span></li>
        <li class="page-item <%= page >= totalPages ? 'disabled' : '' %>">
          <a class="page-link" href="/products?page=<%= Math.min(totalPages, page + 1) %><%= search ? `&search=${encodeURIComponent(search)}` : '' %><%= category ? `&category=${encodeURIComponent(category)}` : '' %><%= priceMin ? `&priceMin=${priceMin}` : '' %><%= priceMax ? `&priceMax=${priceMax}` : '' %><%= grade ? `&grade=${grade}` : '' %><%= availability ? `&availability=${availability}` : '' %>">Next</a>
        </li>
      </ul>
    </nav>
  </div>
<% } %>

<%- include("partials/footer") %>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
