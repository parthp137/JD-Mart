<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>JD Mart</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-sRIl4kxILFvY47J16cr9ZwB07vP4J8+LH7qKQnuqkuIAvNWLzeN8tE5YBujZqJLB" crossorigin="anonymous">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/7.0.1/css/all.min.css">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
   
    <link rel="stylesheet" href="/css/style.css">
</head>
<body>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js" integrity="sha384-7+zCNj/IqJ95wo16oMtfsKbZ9ccEh31eOz1HGyDuCQ6wgnyJNSYdrPa03rtR1zdB" crossorigin="anonymous"></script>

<%- include("partials/header") %>
    
<!-- COMPACT MANDI HERO & LIVE METRICS TICKER -->
<div class="container-fluid px-4 pt-3 pb-1">
  <div class="jd-mandi-compact-hero d-flex flex-wrap align-items-center justify-content-between p-3 rounded-4 mb-3 shadow-sm">
    <div class="d-flex align-items-center gap-3">
      <div class="mandi-hero-icon d-none d-sm-flex align-items-center justify-content-center rounded-3 bg-white text-success shadow-sm">
        <i class="fa-solid fa-wheat-awn fs-4"></i>
      </div>
      <div>
        <div class="d-flex align-items-center gap-2 mb-1 flex-wrap">
          <span class="badge bg-success text-white px-2 py-0.5 rounded-pill small fw-semibold">
            <i class="fa-regular fa-star me-1"></i> APMC Verified
          </span>
          <span class="badge bg-white text-success border px-2 py-0.5 rounded-pill small fw-semibold d-none d-md-inline-flex align-items-center">
            <i class="fa-solid fa-cube me-1"></i> 3D Lot Inspection
          </span>
        </div>
        <h4 class="mb-0 fw-bold text-white">Direct Farm & Mandi Commodities</h4>
      </div>
    </div>

    <!-- Right Trust Signals -->
    <div class="d-none d-lg-flex align-items-center gap-3 text-white small mt-2 mt-lg-0">
      <span class="d-inline-flex align-items-center gap-1.5 opacity-90">
        <i class="fa-regular fa-truck"></i> 1-4 Days Doorstep Delivery
      </span>
      <span class="d-inline-flex align-items-center gap-1.5 opacity-90">
        <i class="fa-solid fa-shield-halved"></i> 100% Escrow Protected
      </span>
    </div>
  </div>

  <!-- COMPACT 4-METRIC STRIP (Above-the-Fold KPI Ticker) -->
  <div class="mandi-metrics-strip d-flex flex-wrap gap-2 mb-3">
    <div class="metric-pill flex-grow-1">
      <div class="metric-icon leaf"><i class="fa-solid fa-leaf"></i></div>
      <div class="metric-body">
        <strong class="metric-val"><%= dashboardStats.totalCategories?.[0]?.count || 0 %></strong>
        <span class="metric-lbl">Commodities</span>
      </div>
    </div>

    <div class="metric-pill flex-grow-1">
      <div class="metric-icon box"><i class="fa-solid fa-cube"></i></div>
      <div class="metric-body">
        <strong class="metric-val"><%= dashboardStats.inStock?.[0]?.count || 0 %></strong>
        <span class="metric-lbl">Lots In Stock</span>
      </div>
    </div>

    <div class="metric-pill flex-grow-1">
      <div class="metric-icon trend"><i class="fa-solid fa-arrow-trend-down"></i></div>
      <div class="metric-body">
        <strong class="metric-val"><%= dashboardStats.belowMarket?.[0]?.count || 0 %></strong>
        <span class="metric-lbl">Below Mandi</span>
      </div>
    </div>

    <div class="metric-pill flex-grow-1">
      <div class="metric-icon star"><i class="fa-regular fa-star"></i></div>
      <div class="metric-body">
        <strong class="metric-val"><%= dashboardStats.gradeA?.[0]?.count || 0 %></strong>
        <span class="metric-lbl">Grade A Certified</span>
      </div>
    </div>
  </div>

  <!-- STREAMLINED COMPACT FILTER TOOLBAR -->
  <div class="jd-compact-filter-bar p-3 rounded-3 shadow-sm mb-3">
    <form id="filterForm" method="GET" action="/products">
      <!-- ROW 1: CATEGORY PILLS -->
      <div class="d-flex align-items-center justify-content-between flex-wrap gap-2 pb-2.5 border-bottom mb-2.5">
        <div class="category-filters m-0 d-flex gap-1.5 flex-wrap">
          <button type="button" class="cat-btn <%= !category || category === 'all' ? 'active' : '' %>" data-category="all" onclick="filterByCategory('all')">
            <i class="fa-solid fa-border-all me-1"></i> All
          </button>
          <button type="button" class="cat-btn <%= category === 'Grains' ? 'active' : '' %>" data-category="Grains" onclick="filterByCategory('Grains')">
            <i class="fa-solid fa-wheat-awn me-1"></i> Grains
          </button>
          <button type="button" class="cat-btn <%= category === 'Pulses' ? 'active' : '' %>" data-category="Pulses" onclick="filterByCategory('Pulses')">
            <i class="fa-solid fa-seedling me-1"></i> Pulses
          </button>
          <button type="button" class="cat-btn <%= category === 'Oilseeds' ? 'active' : '' %>" data-category="Oilseeds" onclick="filterByCategory('Oilseeds')">
            <i class="fa-solid fa-sun me-1"></i> Oilseeds
          </button>
          <button type="button" class="cat-btn <%= category === 'Spices' ? 'active' : '' %>" data-category="Spices" onclick="filterByCategory('Spices')">
            <i class="fa-solid fa-pepper-hot me-1"></i> Spices
          </button>
        </div>

        <div class="d-flex align-items-center gap-2 ms-auto">
          <button type="submit" class="btn btn-sm btn-success fw-bold px-3 py-1.5 shadow-sm">
            <i class="fa-solid fa-filter me-1"></i> Filter
          </button>
          <a href="/products" class="btn btn-sm btn-outline-secondary py-1.5 px-2.5" title="Reset all filters">
            <i class="fa-solid fa-rotate-left"></i>
          </a>
        </div>
      </div>

      <!-- ROW 2: INLINE QUICK REFINEMENTS -->
      <div class="d-flex align-items-center flex-wrap gap-3">
        <!-- Quick Price Presets & Range -->
        <div class="d-flex align-items-center gap-1.5 flex-wrap">
          <span class="small fw-semibold text-muted d-flex align-items-center me-1">
            <i class="fa-solid fa-indian-rupee-sign text-success me-1"></i> Rate (₹/kg):
          </span>
          <div class="btn-group btn-group-sm" role="group">
            <button type="button" class="btn btn-outline-secondary <%= (priceMin == '0' && priceMax == '30') ? 'active bg-success text-white border-success' : '' %>" style="font-size: 0.75rem;" onclick="applyPricePreset(0, 30)">
              &lt; ₹30
            </button>
            <button type="button" class="btn btn-outline-secondary <%= (priceMin == '30' && priceMax == '70') ? 'active bg-success text-white border-success' : '' %>" style="font-size: 0.75rem;" onclick="applyPricePreset(30, 70)">
              ₹30 - ₹70
            </button>
            <button type="button" class="btn btn-outline-secondary <%= (priceMin == '70' && !priceMax) ? 'active bg-success text-white border-success' : '' %>" style="font-size: 0.75rem;" onclick="applyPricePreset(70, '')">
              &gt; ₹70
            </button>
          </div>
          <div class="d-inline-flex align-items-center gap-1 ms-1">
            <input type="number" name="priceMin" id="priceMin" class="form-control form-control-sm" style="width: 70px; height: 28px; font-size: 0.75rem;" value="<%= priceMin || '' %>" placeholder="Min">
            <span class="text-muted small">-</span>
            <input type="number" name="priceMax" id="priceMax" class="form-control form-control-sm" style="width: 70px; height: 28px; font-size: 0.75rem;" value="<%= priceMax || '' %>" placeholder="Max">
            <% if (priceMin || priceMax) { %>
              <button type="button" class="btn btn-link text-danger p-0 ms-0.5 text-decoration-none" onclick="applyPricePreset('', '')" title="Reset price">
                <i class="fa-solid fa-xmark"></i>
              </button>
            <% } %>
          </div>
        </div>

        <!-- Grade Selector -->
        <div class="d-flex align-items-center gap-1.5">
          <label for="gradeFilter" class="small fw-semibold text-muted mb-0"><i class="fa-solid fa-certificate text-warning me-1"></i> Grade:</label>
          <select name="grade" id="gradeFilter" class="form-select form-select-sm" style="height: 28px; font-size: 0.75rem; width: auto;" onchange="this.form.submit()">
            <option value="">All</option>
            <option value="A" <%= grade === 'A' ? 'selected' : '' %>>Grade A (Premium)</option>
            <option value="B" <%= grade === 'B' ? 'selected' : '' %>>Grade B (Standard)</option>
            <option value="C" <%= grade === 'C' ? 'selected' : '' %>>Grade C (Fair)</option>
          </select>
        </div>

        <!-- Stock Selector -->
        <div class="d-flex align-items-center gap-1.5">
          <label for="availabilityFilter" class="small fw-semibold text-muted mb-0"><i class="fa-solid fa-boxes-stacked text-primary me-1"></i> Stock:</label>
          <select name="availability" id="availabilityFilter" class="form-select form-select-sm" style="height: 28px; font-size: 0.75rem; width: auto;" onchange="this.form.submit()">
            <option value="">All</option>
            <option value="in-stock" <%= availability === 'in-stock' ? 'selected' : '' %>>In Stock</option>
            <option value="low-stock" <%= availability === 'low-stock' ? 'selected' : '' %>>Low Stock (&le;5)</option>
          </select>
        </div>
      </div>

      <!-- Hidden inputs for search -->
      <input type="hidden" name="search" value="<%= search || '' %>">
      <input type="hidden" id="categoryInput" name="category" value="<%= category || '' %>">
    </form>
  </div>
</div>

<!-- ACTIVE FILTER PILLS (Dynamic) -->
<div class="container-fluid px-4" id="activeFilterSection">
  <% 
    const hasActiveFilters = (category && category !== 'all') || grade || availability || priceMin || priceMax || search;
    if (hasActiveFilters) { 
  %>
    <div class="active-filters-bar shadow-sm">
      <span class="small fw-bold text-success me-1"><i class="fa-solid fa-sliders me-1"></i> Active Filters:</span>
      <% if (category && category !== 'all') { %>
        <span class="filter-chip">
          <i class="fa-solid fa-tag text-xs text-muted"></i> Category: <strong><%= category %></strong>
          <span class="filter-chip-remove" onclick="clearFilter('category')" title="Remove filter">✕</span>
        </span>
      <% } %>
      <% if (grade) { %>
        <span class="filter-chip">
          <i class="fa-solid fa-star text-xs text-warning"></i> Grade: <strong><%= grade %></strong>
          <span class="filter-chip-remove" onclick="clearFilter('grade')" title="Remove filter">✕</span>
        </span>
      <% } %>
      <% if (availability) { %>
        <span class="filter-chip">
          <i class="fa-solid fa-box text-xs text-primary"></i> Stock: <strong><%= availability === 'in-stock' ? 'In Stock' : 'Low Stock' %></strong>
          <span class="filter-chip-remove" onclick="clearFilter('availability')" title="Remove filter">✕</span>
        </span>
      <% } %>
      <% if (priceMin || priceMax) { %>
        <span class="filter-chip">
          <i class="fa-solid fa-indian-rupee-sign text-xs text-success"></i> Rate: <strong>₹<%= priceMin || '0' %> - ₹<%= priceMax || 'Any' %>/kg</strong>
          <span class="filter-chip-remove" onclick="clearFilter('price')" title="Remove filter">✕</span>
        </span>
      <% } %>
      <% if (search) { %>
        <span class="filter-chip">
          <i class="fa-solid fa-magnifying-glass text-xs text-info"></i> Search: <strong>"<%= search %>"</strong>
          <span class="filter-chip-remove" onclick="clearFilter('search')" title="Remove filter">✕</span>
        </span>
      <% } %>
      <a href="/products" class="btn-clear-filters ms-auto" title="Reset all search & filter parameters">
        <i class="fa-solid fa-xmark"></i> Clear All Filters
      </a>
    </div>
  <% } %>
</div>

<script>
  function filterByCategory(cat) {
    document.getElementById('categoryInput').value = cat === 'all' ? '' : cat;
    document.getElementById('filterForm').submit();
  }

  function applyPricePreset(min, max) {
    document.getElementById('priceMin').value = min !== null ? min : '';
    document.getElementById('priceMax').value = max !== null ? max : '';
    document.getElementById('filterForm').submit();
  }

  function clearFilter(filterType) {
    const url = new URL(window.location.href);
    if (filterType === 'price') {
      url.searchParams.delete('priceMin');
      url.searchParams.delete('priceMax');
    } else {
      url.searchParams.delete(filterType);
    }
    url.searchParams.set('page', '1');
    window.location.href = url.toString();
  }
</script>

<% if (typeof error !== 'undefined' && error) { %>
  <div class="container-fluid px-4">
    <div class="alert alert-danger"><%= error %></div>
  </div>
<% } %>

<% if (typeof message !== 'undefined' && message) { %>
  <div class="container-fluid px-4">
    <div class="alert alert-success"><%= message %></div>
  </div>
<% } %>

<div id="recentlyViewedSection" class="container-fluid px-4 mb-4 d-none">
  <div class="d-flex align-items-center justify-content-between mb-3">
    <h5 class="mb-0 fw-bold"><i class="fa-solid fa-clock-rotate-left text-success me-2"></i>Recently Viewed</h5>
    <button type="button" class="btn btn-sm btn-link text-muted text-decoration-none" id="clearRecentlyViewed">Clear</button>
  </div>
  <div class="row row-cols-2 row-cols-md-4 row-cols-lg-6 g-3" id="recentlyViewedGrid"></div>
</div>

<div class="container-fluid px-4 mb-3 d-flex align-items-center justify-content-between flex-wrap gap-2">
  <span class="text-muted small"><%= totalProducts || 0 %> products found</span>
  <form method="GET" action="/products" class="d-flex align-items-center gap-2">
    <label for="sortBy" class="small fw-semibold text-muted mb-0">Sort by</label>
    <select name="sort" id="sortBy" class="form-select form-select-sm" onchange="this.form.submit()" aria-label="Sort products">
      <option value="newest" <%= sortBy === 'newest' ? 'selected' : '' %>>Newest</option>
      <option value="price-low" <%= sortBy === 'price-low' ? 'selected' : '' %>>Price: Low to High</option>
      <option value="price-high" <%= sortBy === 'price-high' ? 'selected' : '' %>>Price: High to Low</option>
      <option value="demand" <%= sortBy === 'demand' ? 'selected' : '' %>>Highest Demand</option>
    </select>
    <input type="hidden" name="search" value="<%= search || '' %>">
    <input type="hidden" name="category" value="<%= category || '' %>">
    <input type="hidden" name="priceMin" value="<%= priceMin || '' %>">
    <input type="hidden" name="priceMax" value="<%= priceMax || '' %>">
    <input type="hidden" name="grade" value="<%= grade || '' %>">
    <input type="hidden" name="availability" value="<%= availability || '' %>">
  </form>
</div>

    <!-- No Results State -->
    <% if (!allProducts || allProducts.length === 0) { %>
      <div class="container-fluid px-4" style="margin: 4rem 0;">
        <div style="text-align: center; padding: 3rem;">
          <i class="fa-solid fa-search" style="font-size: 4rem; color: #d1d5db; margin-bottom: 1rem;"></i>
          <h3 style="color: #6b7280; margin-bottom: 0.5rem;">No Products Found</h3>
          <p style="color: #9ca3af; margin-bottom: 1.5rem;">
            Try adjusting your filters or search terms
          </p>
          <a href="/products" class="btn btn-success">
            <i class="fa-solid fa-redo"></i> Clear Filters
          </a>
        </div>
      </div>
    <% } else { %>

    <!-- Product Cards -->
 <div class="row row-cols-lg-4 row-cols-md-3 row-cols-sm-1 gx-4 px-4 mb-5" id="productGrid">

    <% for(let product of allProducts){ 
      const actualAvailable = Math.max(0, product.available - (product.reserved || 0));
    %>
    <div class="col mb-4 product-card-col">
      <div class="jd-card h-100 d-flex flex-column border-0 shadow-sm rounded-4 overflow-hidden">

        <!-- IMAGE & OVERLAY BADGES -->
        <div class="jd-image position-relative">
          <!-- COMPARE CHECKBOX TRIGGER -->
          <label class="compare-checkbox-wrapper" onclick="event.stopPropagation();" title="Add to side-by-side comparison matrix">
            <input 
              type="checkbox" 
              class="compare-item-chk form-check-input mt-0" 
              data-id="<%= product._id %>"
              data-name="<%= product.name.replace(/"/g, '&quot;') %>"
              data-category="<%= product.category %>"
              data-grade="<%= product.grade %>"
              data-price="<%= (product.pricePerQuintal / 100).toFixed(2) %>"
              data-moisture="11.8%"
              data-purity="99.4%"
              data-supplier="<%= (product.supplier && product.supplier.name) ? product.supplier.name.replace(/"/g, '&quot;') : 'APMC Mandi Farmer' %>"
              data-location="<%= (product.supplier && product.supplier.location) ? product.supplier.location.replace(/"/g, '&quot;') : 'Gujarat Mandi' %>"
              data-delivery="<%= product.deliveryTime ? `${product.deliveryTime.minDays}-${product.deliveryTime.maxDays} days` : '1-4 days' %>"
              data-image="<%= getImageUrl(product.images) %>"
              onchange="handleCompareToggle(this)"
            >
            <span>Compare</span>
          </label>

          <a href="/products/<%= product._id %>" class="d-block h-100">
            <img
              src="<%= getImageUrl(product.images) %>"
              alt="<%= product.name %>"
              class="jd-image-tag w-100 h-100"
              style="object-fit: cover;"
              onerror="this.onerror=null;this.src='<%= getCropPlaceholder(product.category || product.name) %>'"
            >
          </a>

          <!-- TOP BADGES -->
          <div class="jd-badges">
            <span class="jd-grade <%= product.grade === 'A' ? 'grade-a' : (product.grade === 'B' ? 'grade-b' : '') %> quality-chip quality-chip-grade shadow-sm" onclick="event.stopPropagation(); openCropInspection('<%= product.name.replace(/'/g, "\\'") %>', '<%= product.grade %>', '<%= product.category %>', '11.8%', '<%= (product.supplier && product.supplier.name) ? product.supplier.name.replace(/'/g, "\\'") : 'APMC Mandi Farmer' %>')" title="Click to view lab certificate">
              <i class="fa-solid fa-certificate"></i> Grade <%= product.grade %>
            </span>

            <div class="d-flex flex-column align-items-end gap-1">
              <% if (product.belowMarketPercent > 0) { %>
                <span class="jd-market shadow-sm">
                  <i class="fa-solid fa-arrow-trend-down"></i>
                  <%= product.belowMarketPercent %>% below mandi
                </span>
              <% } %>

              <% if (actualAvailable <= 0) { %>
                <span class="badge bg-danger shadow-sm">
                  <i class="fa-solid fa-exclamation-circle"></i> Out of Stock
                </span>
              <% } else if (actualAvailable <= 5) { %>
                <span class="badge bg-warning text-dark pulse-badge shadow-sm">
                  <i class="fa-solid fa-fire text-danger"></i> Only <%= actualAvailable %> left
                </span>
              <% } %>
            </div>
          </div>
        </div>

        <!-- BODY -->
        <div class="jd-body d-flex flex-column flex-grow-1 p-3">

          <div class="d-flex justify-content-between align-items-center mb-1">
            <span class="badge bg-success-subtle text-success border border-success-subtle rounded-pill small fw-semibold">
              <%= product.category %>
            </span>
            <span class="jd-demand <%= product.demandLevel.toLowerCase() %> small">
              <%= product.demandLevel %> Demand
            </span>
          </div>

          <h5 class="jd-product-name mb-2 text-truncate" title="<%= product.name %>">
            <a href="/products/<%= product._id %>" class="text-decoration-none text-dark fw-bold hover-success"><%= product.name %></a>
          </h5>

          <!-- STREAMLINED COMMODITY SPECS ROW -->
          <div class="d-flex align-items-center justify-content-between p-2 rounded-2 bg-light border mb-2" style="font-size: 0.78rem;">
            <span class="text-muted d-inline-flex align-items-center" title="Lab Tested Moisture Content">
              <i class="fa-solid fa-droplet text-info me-1"></i> 11.8% Moist
            </span>
            <span class="text-success fw-semibold d-inline-flex align-items-center" style="cursor: pointer;" onclick="event.stopPropagation(); openTraceabilityPassport('<%= product.name.replace(/'/g, "\\'") %>', '<%= product.grade %>', '<%= product.category %>', '<%= (product.supplier && product.supplier.name) ? product.supplier.name.replace(/'/g, "\\'") : 'Patel Organic Farms' %>', '<%= (product.supplier && product.supplier.location) ? product.supplier.location.replace(/'/g, "\\'") : 'Unjha APMC Yard, Gujarat' %>')" title="View Origin Passport">
              <i class="fa-solid fa-seedling me-1"></i> Origin
            </span>
            <div class="sparkline-container" data-sparkline-target="true" data-grade="<%= product.grade %>" title="7-day APMC Mandi Price Trend">
              <svg class="sparkline-svg" viewBox="0 0 45 16" style="width: 38px; height: 14px;">
                <path d="M 2 12 L 10 9 L 18 11 L 26 6 L 34 8 L 42 3" fill="none" stroke="#16a34a" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                <circle cx="42" cy="3" r="2" fill="#16a34a"/>
              </svg>
            </div>
          </div>

          <!-- PRICE HIGHLIGHT -->
          <div class="jd-price mt-auto mb-2">
            <div class="d-flex align-items-baseline gap-1">
              <span class="fs-4 fw-bold text-success">
                ₹<%= (product.pricePerQuintal / 100).toFixed(2) %>
              </span>
              <span class="text-muted small">/kg</span>
              <% if (product.oldPrice > product.pricePerQuintal) { %>
                <span class="text-muted text-decoration-line-through small ms-1">
                  ₹<%= (product.oldPrice / 100).toFixed(2) %>
                </span>
              <% } %>
            </div>
            <small class="text-muted d-block" style="font-size: 0.78rem;">
              ₹<%= ((product.pricePerQuintal * 100) / 100).toFixed(0) %> / Quintal (100 kg)
            </small>
          </div>

          <!-- STREAMLINED ACTION BUTTON HIERARCHY -->
          <div class="jd-card-actions pt-2 border-top mt-auto">
            <div class="d-flex align-items-center gap-1.5">
              <% if (actualAvailable > 0) { %>
                <form action="/cart/add/<%= product._id %>" method="POST" class="flex-grow-1 m-0">
                  <input type="hidden" name="quantity" value="<%= product.moq || 1 %>">
                  <button type="submit" class="btn btn-sm btn-success w-100 fw-semibold py-1.5 d-flex align-items-center justify-content-center gap-1.5 shadow-sm btn-add-cart">
                    <i class="fa-solid fa-cart-plus"></i>
                    <span>Add to Cart</span>
                  </button>
                </form>
              <% } else { %>
                <button type="button" class="btn btn-sm btn-light border text-muted w-100 py-1.5" disabled>
                  <i class="fa-solid fa-ban me-1"></i> Out of Stock
                </button>
              <% } %>

              <!-- Secondary: Instant RFQ wholesale negotiate -->
              <button type="button" class="btn btn-sm btn-outline-dark px-2.5 py-1.5 fw-semibold d-inline-flex align-items-center gap-1" onclick="openRfqDrawer('<%= product._id %>', '<%= product.name.replace(/'/g, "\\'") %>', <%= (product.pricePerQuintal / 100) %>, '<%= (product.supplier && product.supplier.location) ? product.supplier.location.replace(/'/g, "\\'") : 'APMC Mandi' %>')" title="Submit wholesale counter-offer (RFQ)">
                <i class="fa-solid fa-handshake text-success"></i>
                <span class="small">RFQ</span>
              </button>

              <!-- Lot details eye -->
              <a href="/products/<%= product._id %>" class="btn btn-sm btn-light border text-secondary px-2 py-1.5" title="Inspect Lot Details & Lab Certificate">
                <i class="fa-regular fa-eye"></i>
              </a>

              <!-- Mandi Target Price Alert -->
              <button type="button" class="btn btn-sm btn-light border text-secondary px-2 py-1.5" onclick="openPriceAlertModal('<%= product._id %>', '<%= product.name.replace(/'/g, "\\'") %>', <%= (product.pricePerQuintal / 100) %>)" title="Set Mandi Target Price Alert">
                <i class="fa-regular fa-bell"></i>
              </button>
            </div>
          </div>

          <div class="d-flex justify-content-between align-items-center mt-2 pt-2 border-top text-muted small" style="font-size: 0.75rem;">
            <span>
              <i class="fa-solid fa-boxes-stacked text-success me-1"></i>
              <%= product.available * 100 %> kg
            </span>
            <span>
              <i class="fa-regular fa-clock me-1"></i>
              <%= product.deliveryTime ? product.deliveryTime.minDays : 1 %>-<%= product.deliveryTime ? product.deliveryTime.maxDays : 4 %> days
            </span>
          </div>

        </div>
      </div>
    </div>
    <% } %>
    </div>
    <% } %>

<% if (typeof totalPages !== 'undefined' && totalPages > 1) { %>
  <div class="container-fluid px-4 mb-5">
    <nav aria-label="Product pagination">
      <ul class="pagination justify-content-center mt-3">
        <li class="page-item <%= page <= 1 ? 'disabled' : '' %>">
          <a class="page-link" href="/products?page=<%= Math.max(1, page - 1) %><%= search ? `&search=${encodeURIComponent(search)}` : '' %><%= category ? `&category=${encodeURIComponent(category)}` : '' %><%= priceMin ? `&priceMin=${priceMin}` : '' %><%= priceMax ? `&priceMax=${priceMax}` : '' %><%= grade ? `&grade=${grade}` : '' %><%= availability ? `&availability=${availability}` : '' %><%= sortBy ? `&sort=${encodeURIComponent(sortBy)}` : '' %>">Previous</a>
        </li>
        <li class="page-item disabled"><span class="page-link">Page <%= page %> of <%= totalPages %></span></li>
        <li class="page-item <%= page >= totalPages ? 'disabled' : '' %>">
          <a class="page-link" href="/products?page=<%= Math.min(totalPages, page + 1) %><%= search ? `&search=${encodeURIComponent(search)}` : '' %><%= category ? `&category=${encodeURIComponent(category)}` : '' %><%= priceMin ? `&priceMin=${priceMin}` : '' %><%= priceMax ? `&priceMax=${priceMax}` : '' %><%= grade ? `&grade=${grade}` : '' %><%= availability ? `&availability=${availability}` : '' %><%= sortBy ? `&sort=${encodeURIComponent(sortBy)}` : '' %>">Next</a>
        </li>
      </ul>
    </nav>
  </div>
<% } %>

<%- include("partials/footer") %>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js"></script>
<script>
  (() => {
    const storageKey = "jdMartRecentlyViewed";
    const section = document.getElementById("recentlyViewedSection");
    const grid = document.getElementById("recentlyViewedGrid");
    const clearButton = document.getElementById("clearRecentlyViewed");
    if (!section || !grid) return;

    const escapeHtml = (value) => String(value).replace(/[&<>'"]/g, (character) => ({
      "&": "&amp;", "<": "&lt;", ">": "&gt;", "'": "&#39;", '"': "&quot;"
    }[character]));

    const recentItems = JSON.parse(localStorage.getItem(storageKey) || "[]").slice(0, 6);
    if (!recentItems.length) return;

    grid.innerHTML = recentItems.map((item) => `
      <div class="col">
        <a href="${escapeHtml(item.url)}" class="recent-product-card text-decoration-none">
          <img src="${escapeHtml(item.image)}" alt="${escapeHtml(item.name)}" onerror="this.src='/images/placeholder.png'">
          <strong>${escapeHtml(item.name)}</strong>
          <small>₹${escapeHtml(item.price)}/kg</small>
        </a>
      </div>
    `).join("");
    section.classList.remove("d-none");

    clearButton?.addEventListener("click", () => {
      localStorage.removeItem(storageKey);
      section.classList.add("d-none");
    });
  })();
</script>
</body>
</html>

