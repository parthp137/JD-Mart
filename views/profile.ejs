<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>JD Mart | Profile</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-sRIl4kxILFvY47J16cr9ZwB07vP4J8+LH7qKQnuqkuIAvNWLzeN8tE5YBujZqJLB" crossorigin="anonymous">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/7.0.1/css/all.min.css">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="/css/style.css">
    <link rel="stylesheet" href="/css/profile.css">
</head>
<body>

<%- include("partials/header") %>
    

<!-- MAIN CONTAINER -->
<div class="container-fluid my-4 p-4 rounded shadow-sm bg-light ">

  <!-- PROFILE HEADER CARD -->
  <div class="profile-card d-flex justify-content-between align-items-center"> 
    
    <div class="d-flex align-items-center gap-4">
      <div class="avatar">
        <%= user.fullName.charAt(0).toUpperCase() %>
      </div>

      <div>
        <h4 class="mb-1">
          <%= user.fullName %>
          <span class="badge-role ms-2"><%= user.businessType %></span>
        </h4>

        <p class="mb-1 text-muted"><%= user.business %></p>

        <div class="text-muted small d-flex gap-3">
          <span><i class="fa-regular fa-calendar me-1"></i> Member since <%= new Date(user.createdAt).toLocaleDateString() %></span>
          <span><i class="fa-regular fa-envelope me-1"></i> <%= user.email %></span>
        </div>
      </div>
    </div>

    <a href="/profile/edit" class="edit-btn">
      <i class="fa-solid fa-pencil me-1"></i> Edit Profile
    </a>
  </div>

  <!-- INFO GRID -->
  <div class="row g-4">

    <!-- PERSONAL INFO -->
    <div class="col-md-6">
      <div class="info-box">
        <h5><i class="fa-regular fa-user text-success me-2"></i> Personal Information</h5>

        <div class="mb-3">
          <label class="form-label">Full Name</label>
          <input type="text" class="form-control" value="<%= user.fullName %>" readonly>
        </div>

        <div class="mb-3">
          <label class="form-label">Email</label>
          <input type="email" class="form-control" value="<%= user.email %>" readonly>
        </div>

        <div>
          <label class="form-label">Phone Number</label>
          <input type="text" class="form-control" value="<%= user.phone %>" readonly>
        </div>
      </div>
    </div>

    <!-- BUSINESS INFO -->
    <div class="col-md-6">
      <div class="info-box">
        <h5><i class="fa-solid fa-building text-success me-2"></i> Business Information</h5>

        <div class="mb-3">
          <label class="form-label">Business Name</label>
          <input type="text" class="form-control" value="<%= user.business %>" readonly>
        </div>

        <div class="mb-3">
          <label class="form-label">Business Type</label>
          <input type="text" class="form-control" value="<%= user.businessType %>" readonly>
        </div>

        <div>
          <label class="form-label">GST Number (Optional)</label>
          <input type="text" class="form-control" value="<%= user.gst || 'Not Provided' %>" readonly>
        </div>
      </div>
    </div>
  </div>

  <!-- ADDRESS -->
  <div class="address-box mt-4">
    <h5><i class="fa-solid fa-location-dot text-success me-2"></i> Default Delivery Address</h5>
    <p class="text-muted mb-0">
  <%= user.defaultAddress || "No address added yet" %>
</p>

  </div>

</div>

<%- include("partials/footer") %>

<script src="/js/script.js"></script>
</body>
</html>
