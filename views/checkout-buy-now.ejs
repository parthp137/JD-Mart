<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>JD Mart | Buy Now</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-sRIl4kxILFvY47J16cr9ZwB07vP4J8+LH7qKQnuqkuIAvNWLzeN8tE5YBujZqJLB" crossorigin="anonymous">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/7.0.1/css/all.min.css">
    <link rel="stylesheet" href="/css/style.css">
    <style>
        .checkout-header {
            background: linear-gradient(135deg, #16a34a 0%, #15803d 100%);
            color: white;
            padding: 25px 0;
            margin-bottom: 30px;
        }
        .step-indicator {
            display: flex;
            justify-content: space-between;
            margin-bottom: 30px;
        }
        .step-item {
            flex: 1;
            text-align: center;
            padding: 15px;
        }
        .step-item.active .step-circle {
            background: #16a34a;
            color: white;
        }
        .step-item.active .step-title {
            font-weight: 600;
            color: #16a34a;
        }
        .step-circle {
            width: 40px;
            height: 40px;
            border-radius: 50%;
            background: #e5e7eb;
            display: flex;
            align-items: center;
            justify-content: center;
            margin: 0 auto 8px;
            font-weight: 600;
        }
        .step-title {
            font-size: 14px;
            color: #666;
        }
        .address-option {
            padding: 15px;
            border: 2px solid #e5e7eb;
            border-radius: 8px;
            margin-bottom: 12px;
            cursor: pointer;
            transition: all 0.3s;
        }
        .address-option:hover {
            border-color: #16a34a;
            background: #f0fdf4;
        }
        .address-option.selected {
            border-color: #16a34a;
            background: #f0fdf4;
        }
        .address-option input[type="radio"] {
            margin-right: 12px;
        }
        .delivery-info {
            background: #f9fafb;
            padding: 15px;
            border-radius: 8px;
            margin-top: 20px;
        }
        .order-item {
            display: flex;
            justify-content: space-between;
            padding: 15px 0;
            border: 1px solid #e5e7eb;
            border-radius: 8px;
            padding: 15px;
            background: #f9fafb;
        }
        .item-image {
            width: 80px;
            height: 80px;
            background-size: cover;
            background-position: center;
            border-radius: 8px;
            margin-right: 15px;
        }
        .item-details {
            flex: 1;
        }
        .item-name {
            font-weight: 600;
            margin-bottom: 4px;
        }
        .item-qty {
            font-size: 14px;
            color: #666;
            margin-bottom: 8px;
        }
        .item-price {
            font-weight: 600;
            color: #16a34a;
        }
        .summary-row {
            display: flex;
            justify-content: space-between;
            padding: 12px 0;
        }
        .summary-row.total {
            border-top: 2px solid #e5e7eb;
            margin-top: 12px;
            padding-top: 12px;
            font-weight: 600;
            font-size: 18px;
            color: #16a34a;
        }
    </style>
</head>
<body>

<nav class="navbar navbar-expand-lg navbar-light bg-body-light border-bottom sticky-top">
  <div class="container-fluid">
    <a class="navbar-brand d-flex align-items-center" href="/products">
      <img src="/images/image.png" alt="JD Mart Logo" height="40" style="border-radius: 8px;"/>
      <span class="ms-2 fw-bold">JD Mart</span>
    </a>
  </div>
</nav>

<div class="checkout-header">
    <div class="container">
        <h2 class="mb-0"><i class="fa-solid fa-clipboard-check me-2"></i>Confirm Your Order</h2>
    </div>
</div>

<div class="container">
    <% if (typeof error !== 'undefined' && error) { %>
        <div class="alert alert-danger"><%= error %></div>
    <% } %>

    <% if (typeof message !== 'undefined' && message) { %>
        <div class="alert alert-success"><%= message %></div>
    <% } %>

    <div class="step-indicator">
        <div class="step-item active">
            <div class="step-circle">1</div>
            <div class="step-title">Review Order</div>
        </div>
        <div class="step-item active">
            <div class="step-circle">2</div>
            <div class="step-title">Delivery Address</div>
        </div>
        <div class="step-item">
            <div class="step-circle">3</div>
            <div class="step-title">Confirm & Pay</div>
        </div>
    </div>

    <div class="row">
        <!-- Order Summary -->
        <div class="col-lg-8">
            <div class="card mb-4">
                <div class="card-header bg-white">
                    <h5 class="mb-0"><i class="fa-solid fa-box me-2"></i>Your Order</h5>
                </div>
                <div class="card-body">
                    <div class="order-item">
                                                <div class="item-image">
                                                        <img
                                                            src="<%= getImageUrl(item.images) %>"
                                                            alt="<%= item.productName %>"
                                                            class="item-image-tag"
                                                            onerror="this.onerror=null;this.src='<%= getCropPlaceholder(item.category || item.productName) %>'"
                                                        >
                                                </div>
                        <div class="item-details">
                            <div class="item-name"><%= item.productName %></div>
                            <div class="item-qty">Quantity: <%= item.quantity %> kg</div>
                            <div class="item-qty">Price: ₹<%= (item.price / 100).toFixed(2) %>/kg</div>
                            <div class="item-price">Total: ₹<%= ((item.quantity * item.price) / 100).toFixed(2) %></div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Delivery Address Selection -->
            <div class="card">
                <div class="card-header bg-white">
                    <h5 class="mb-0"><i class="fa-solid fa-location-dot me-2"></i>Delivery Address</h5>
                </div>
                <div class="card-body">
                    <form id="checkoutForm" action="/orders/buy-now-place" method="POST">
                        <% if (user.defaultAddress) { %>
                            <div class="mb-3">
                                <p class="text-muted mb-3">Delivery address:</p>
                                <label class="address-option selected">
                                    <input type="radio" name="deliveryAddress" value="<%= user.defaultAddress %>" checked class="addressRadio">
                                    <strong><i class="fa-solid fa-check-circle me-2" style="color: #16a34a;"></i>Current Address</strong>
                                    <br>
                                    <small class="text-muted"><%= user.defaultAddress %></small>
                                </label>
                            </div>
                        <% } else { %>
                            <div class="alert alert-warning">
                                <i class="fa-solid fa-exclamation-triangle me-2"></i>
                                No delivery address found. Please add one in your profile first.
                            </div>
                            <a href="/profile" class="btn btn-warning">Update Profile</a>
                            <% return; %>
                        <% } %>

                        <div class="delivery-info">
                            <div class="d-flex align-items-start">
                                <i class="fa-solid fa-info-circle me-2 mt-1" style="color: #16a34a;"></i>
                                <div>
                                    <strong>Estimated Delivery</strong>
                                    <p class="mb-0 text-muted">Your order will be delivered within 3-5 business days</p>
                                </div>
                            </div>
                        </div>

                        <!-- Order Summary Card -->
                        <div class="card mt-4">
                            <div class="card-header bg-white">
                                <h5 class="mb-0">Order Summary</h5>
                            </div>
                            <div class="card-body">
                                <div class="summary-row">
                                    <span><%= item.productName %> x <%= item.quantity %> kg</span>
                                    <span>₹<%= ((item.quantity * item.price) / 100).toFixed(2) %></span>
                                </div>
                                <div class="summary-row">
                                    <span>Delivery</span>
                                    <span class="text-success">FREE</span>
                                </div>
                                <div class="summary-row total">
                                    <span>Total Amount</span>
                                    <span>₹<%= (totalAmount / 100).toFixed(2) %></span>
                                </div>
                            </div>
                        </div>

                        <div class="mt-4 d-grid gap-2">
                            <button type="submit" class="btn btn-success btn-lg">
                                <i class="fa-solid fa-check-circle me-2"></i>Place Order
                            </button>
                            <a href="/products" class="btn btn-outline-secondary">
                                <i class="fa-solid fa-arrow-left me-2"></i>Back to Products
                            </a>
                        </div>
                    </form>
                </div>
            </div>
        </div>

        <!-- Right Sidebar Summary -->
        <div class="col-lg-4">
            <div class="card sticky-top" style="top: 80px;">
                <div class="card-header bg-white">
                    <h5 class="mb-0">Order Summary</h5>
                </div>
                <div class="card-body">
                    <div class="summary-row">
                        <strong><%= item.productName %></strong>
                    </div>
                    <div class="summary-row">
                        <span><%= item.quantity %> kg @ ₹<%= (item.price / 100).toFixed(2) %>/kg</span>
                        <span>₹<%= ((item.quantity * item.price) / 100).toFixed(2) %></span>
                    </div>
                    <div class="summary-row">
                        <strong>Delivery</strong>
                        <span class="text-success">FREE</span>
                    </div>
                    <hr>
                    <div class="summary-row total">
                        <strong>Total Amount</strong>
                        <strong style="color: #16a34a;">₹<%= (totalAmount / 100).toFixed(2) %></strong>
                    </div>
                    <div class="alert alert-info mt-3" role="alert">
                        <i class="fa-solid fa-shield-check me-2"></i>
                        <small><strong>Safe & Secure:</strong> Your payment is encrypted and secure</small>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<footer class="jd-footer-section mt-5">
  <div class="container-fluid px-5 mt-3">
    <div class="text-center pb-3">
      <small>© <%= new Date().getFullYear() %> JD Mart. All rights reserved.</small>
    </div>
  </div>
</footer>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
