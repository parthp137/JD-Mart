<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Admin Dashboard - JD Mart</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-sRIl4kxILFvY47J16cr9ZwB07vP4J8+LH7qKQnuqkuIAvNWLzeN8tE5YBujZqJLB" crossorigin="anonymous">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/7.0.1/css/all.min.css">
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
  <style>
    body {
      font-family: 'Inter', sans-serif;
      background-color: #f8faf8;
    }
    .admin-nav {
      background: linear-gradient(to right, #e9f7ee, #ffffff);
      border-bottom: 1px solid #e5e7eb;
      padding: 1rem 2rem;
    }
    .admin-nav-brand {
      color: #16a34a;
      font-weight: 700;
      font-size: 1.4rem;
    }
    .admin-nav-brand small {
      color: #6b7280;
      font-weight: 500;
      font-size: 0.7rem;
    }
    .admin-sidebar {
      background: white;
      border-right: 1px solid #e5e7eb;
      height: 100vh;
      position: fixed;
      width: 250px;
      overflow-y: auto;
    }
    .admin-content {
      margin-left: 250px;
      padding: 2rem;
    }
    .nav-item a {
      color: #4b5563;
      text-decoration: none;
      padding: 0.75rem 1.5rem;
      display: flex;
      align-items: center;
      border-left: 3px solid transparent;
      transition: 0.3s;
    }
    .nav-item a:hover {
      background: #f3f4f6;
      color: #16a34a;
      border-left-color: #16a34a;
    }
    .nav-item a.active {
      background: #ecfdf5;
      color: #16a34a;
      border-left-color: #16a34a;
    }
    .nav-item i {
      margin-right: 0.75rem;
      width: 20px;
    }
    .dashboard-card {
      background: white;
      border: 1px solid #e5e7eb;
      border-radius: 0.5rem;
      padding: 1.5rem;
      margin-bottom: 2rem;
      box-shadow: 0 1px 2px rgba(0, 0, 0, 0.05);
    }
    .dashboard-header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-bottom: 1.5rem;
    }
    .dashboard-header h2 {
      color: #1f2937;
      font-weight: 600;
    }
    .stats-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
      gap: 1.5rem;
      margin-bottom: 2rem;
    }
    .stat-box {
      background: linear-gradient(135deg, #ecfdf5 0%, #f0fdf4 100%);
      border: 1px solid #d1fae5;
      border-radius: 0.5rem;
      padding: 1.5rem;
      text-align: center;
    }
    .stat-box h4 {
      color: #6b7280;
      font-size: 0.875rem;
      font-weight: 500;
      margin-bottom: 0.5rem;
    }
    .stat-box .number {
      color: #16a34a;
      font-size: 2rem;
      font-weight: 700;
    }
    .table-responsive {
      background: white;
      border-radius: 0.5rem;
      overflow: hidden;
      border: 1px solid #e5e7eb;
    }
    .table {
      margin: 0;
    }
    .table thead {
      background: #f9fafb;
      border-bottom: 2px solid #e5e7eb;
    }
    .table thead th {
      color: #6b7280;
      font-weight: 600;
      font-size: 0.875rem;
      text-transform: uppercase;
      padding: 1rem;
    }
    .table tbody td {
      padding: 1rem;
      vertical-align: middle;
      border-bottom: 1px solid #e5e7eb;
    }
    .btn-action {
      padding: 0.25rem 0.75rem;
      font-size: 0.875rem;
      margin: 0 0.25rem;
    }
    .btn-sm {
      padding: 0.4rem 0.8rem;
    }
    .product-image {
      width: 50px;
      height: 50px;
      border-radius: 0.375rem;
      object-fit: cover;
    }
  </style>
</head>
<body>

<!-- Navigation -->
<nav class="admin-nav">
  <div class="d-flex justify-content-between align-items-center">
    <div class="admin-nav-brand">
      <i class="fa-solid fa-leaf"></i> JD Mart <br><small>Admin Panel</small>
    </div>
    <div>
      <span style="color: #6b7280; margin-right: 1rem;"><%= user.fullName %></span>
      <a href="/logout" class="btn btn-outline-danger btn-sm">Logout</a>
    </div>
  </div>
</nav>

<!-- Sidebar -->
<div class="admin-sidebar">
  <div style="padding: 1.5rem;">
    <div class="nav-item">
      <a href="/admin" class="<%= section === 'dashboard' ? 'active' : '' %>">
        <i class="fa-solid fa-chart-line"></i> Dashboard
      </a>
    </div>
    <div class="nav-item">
      <a href="/admin/products" class="<%= section === 'products' ? 'active' : '' %>">
        <i class="fa-solid fa-box"></i> Products
      </a>
    </div>
    <div class="nav-item">
      <a href="/admin/orders" class="<%= section === 'orders' ? 'active' : '' %>">
        <i class="fa-solid fa-receipt"></i> Orders
      </a>
    </div>
    <div class="nav-item">
      <a href="/admin/users" class="<%= section === 'users' ? 'active' : '' %>">
        <i class="fa-solid fa-users"></i> Users
      </a>
    </div>
    <div class="nav-item">
      <a href="/admin/notifications" class="<%= section === 'notifications' ? 'active' : '' %>">
        <i class="fa-solid fa-bell"></i> Notifications
      </a>
    </div>
  </div>
</div>

<!-- Main Content -->
<div class="admin-content">

  <% if (section === 'dashboard') { %>

    <!-- Dashboard Section -->
    <div class="dashboard-card">
      <div class="dashboard-header">
        <h2><i class="fa-solid fa-chart-line"></i> Dashboard Overview</h2>
      </div>

      <div class="stats-grid">
        <div class="stat-box">
          <h4>Total Products</h4>
          <div class="number"><%= stats.totalProducts %></div>
        </div>
        <div class="stat-box">
          <h4>Total Orders</h4>
          <div class="number"><%= stats.totalOrders %></div>
        </div>
        <div class="stat-box">
          <h4>Total Users</h4>
          <div class="number"><%= stats.totalUsers %></div>
        </div>
        <div class="stat-box">
          <h4>Low Stock Items</h4>
          <div class="number"><%= stats.lowStockProducts %></div>
        </div>
      </div>
    </div>

  <% } else if (section === 'products') { %>

    <!-- Products Section -->
    <div class="dashboard-card">
      <div class="dashboard-header">
        <h2><i class="fa-solid fa-box"></i> Product Management</h2>
        <a href="/admin/products/create" class="btn btn-success">
          <i class="fa-solid fa-plus"></i> Add Product
        </a>
      </div>

      <% if (typeof error !== 'undefined' && error) { %>
        <div class="alert alert-danger"><%= error %></div>
      <% } %>

      <% if (typeof message !== 'undefined' && message) { %>
        <div class="alert alert-success"><%= message %></div>
      <% } %>

      <div class="table-responsive">
        <table class="table table-hover">
          <thead>
            <tr>
              <th>Image</th>
              <th>Name</th>
              <th>Category</th>
              <th>Price</th>
              <th>Available</th>
              <th>Reserved</th>
              <th>Grade</th>
              <th>Actions</th>
            </tr>
          </thead>
          <tbody>
            <% products.forEach(product => { %>
              <tr>
                <td>
                  <img src="<%= getImageUrl(product.images) %>" alt="<%= product.name %>" class="product-image"
                       onerror="this.src='<%= getCropPlaceholder(product.category) %>'">
                </td>
                <td><strong><%= product.name %></strong></td>
                <td><span class="badge bg-info"><%= product.category %></span></td>
                <td>₹<%= (product.pricePerQuintal / 100).toFixed(2) %>/kg</td>
                <td>
                  <% const available = product.available - (product.reserved || 0); %>
                  <span class="badge <%= available > 5 ? 'bg-success' : available > 0 ? 'bg-warning' : 'bg-danger' %>">
                    <%= available %>
                  </span>
                </td>
                <td><span class="badge bg-secondary"><%= product.reserved || 0 %></span></td>
                <td>Grade <%= product.grade %></td>
                <td>
                  <a href="/admin/products/<%= product._id %>/edit" class="btn btn-sm btn-primary btn-action" title="Edit">
                    <i class="fa-solid fa-pencil"></i>
                  </a>
                  <form action="/admin/products/<%= product._id %>/delete" method="POST" style="display: inline;" 
                        onsubmit="return confirm('Delete this product?');">
                    <button type="submit" class="btn btn-sm btn-danger btn-action" title="Delete">
                      <i class="fa-solid fa-trash"></i>
                    </button>
                  </form>
                </td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    </div>

  <% } else if (section === 'orders') { %>

    <!-- Orders Section -->
    <div class="dashboard-card">
      <div class="dashboard-header">
        <h2><i class="fa-solid fa-receipt"></i> Order Management</h2>
      </div>

      <div class="table-responsive">
        <table class="table table-hover">
          <thead>
            <tr>
              <th>Order ID</th>
              <th>User</th>
              <th>Items</th>
              <th>Amount</th>
              <th>Status</th>
              <th>Date</th>
              <th>Actions</th>
            </tr>
          </thead>
          <tbody>
            <% orders.forEach(order => { %>
              <tr>
                <td><strong><%= order.orderId %></strong></td>
                <td><%= order.user.fullName %></td>
                <td><%= order.items.length %></td>
                <td>₹<%= (order.totalAmount / 100).toFixed(2) %></td>
                <td>
                  <span class="badge <%= order.status === 'Delivered' ? 'bg-success' : order.status === 'In Transit' ? 'bg-info' : 'bg-warning' %>">
                    <%= order.status %>
                  </span>
                </td>
                <td><%= new Date(order.createdAt).toLocaleDateString() %></td>
                <td>
                  <a href="/orders/<%= order._id %>" class="btn btn-sm btn-info btn-action" title="View">
                    <i class="fa-solid fa-eye"></i>
                  </a>
                </td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    </div>

  <% } else if (section === 'users') { %>

    <!-- Users Section -->
    <div class="dashboard-card">
      <div class="dashboard-header">
        <h2><i class="fa-solid fa-users"></i> User Management</h2>
        <div>
          <input type="text" id="userSearch" placeholder="Search users..." class="form-control" style="width: 300px; display: inline-block;">
        </div>
      </div>

      <div class="table-responsive">
        <table class="table table-hover">
          <thead>
            <tr>
              <th>Name</th>
              <th>Email</th>
              <th>Phone</th>
              <th>Business</th>
              <th>Role</th>
              <th>Joined</th>
              <th>Actions</th>
            </tr>
          </thead>
          <tbody id="usersTable">
            <% users.forEach(u => { %>
              <tr>
                <td><strong><%= u.fullName %></strong></td>
                <td><%= u.email %></td>
                <td><%= u.phone %></td>
                <td><%= u.business %></td>
                <td><span class="badge <%= u.role === 'admin' ? 'bg-danger' : 'bg-success' %>"><%= u.role %></span></td>
                <td><%= new Date(u.createdAt).toLocaleDateString() %></td>
                <td>
                  <a href="/profile/<%= u._id %>" class="btn btn-sm btn-info btn-action" title="View">
                    <i class="fa-solid fa-eye"></i>
                  </a>
                </td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    </div>

  <% } %>

</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js" integrity="sha384-7+zCNj/IqJ95wo16oMtfsKbZ9ccEh31eOz1HGyDuCQ6wgnyJNSYdrPa03rtR1zdB" crossorigin="anonymous"></script>
<script>
  // User search
  const userSearch = document.getElementById('userSearch');
  if (userSearch) {
    userSearch.addEventListener('input', (e) => {
      const query = e.target.value.toLowerCase();
      const rows = document.querySelectorAll('#usersTable tr');
      rows.forEach(row => {
        const text = row.textContent.toLowerCase();
        row.style.display = text.includes(query) ? '' : 'none';
      });
    });
  }
</script>
</body>
</html>
