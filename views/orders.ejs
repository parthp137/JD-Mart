<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>JD Mart | Order History</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-sRIl4kxILFvY47J16cr9ZwB07vP4J8+LH7qKQnuqkuIAvNWLzeN8tE5YBujZqJLB" crossorigin="anonymous">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/7.0.1/css/all.min.css">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="/css/style.css">
    <link rel="stylesheet" href="/css/orders.css">
</head>
<body>

<%- include("partials/header") %>
    
<!-- PAGE -->
<div class="container my-4">


  <% if (typeof error !== 'undefined' && error) { %>
    <div class="alert alert-danger"><%= error %></div>
  <% } %>

  <% if (typeof message !== 'undefined' && message) { %>
    <div class="alert alert-success"><%= message %></div>
  <% } %>

  <div class="title-row">
    <div>
      <h1>Order History</h1>
      <div class="subtitle">Track and manage your orders</div>
    </div>

    <select class="filter">
      <option>All Orders</option>
      <option>Delivered</option>
      <option>In Transit</option>
      <option>Pending</option>
    </select>
  </div>

  <!-- STATS -->
  <div class="stats">
    <div class="stat-card">
      <div class="icon-box green"><i class="ri-box-3-line"></i></div>
      <div>
        <div class="stat-number"><%= stats.total %></div>
        <div class="stat-label">Total Orders</div>
      </div>
    </div>

    <div class="stat-card">
      <div class="icon-box blue"><i class="ri-truck-line"></i></div>
      <div>
        <div class="stat-number"><%= stats.transit %></div>
        <div class="stat-label">In Transit</div>
      </div>
    </div>

    <div class="stat-card">
      <div class="icon-box green"><i class="ri-check-line"></i></div>
      <div>
        <div class="stat-number"><%= stats.delivered %></div>
        <div class="stat-label">Delivered</div>
      </div>
    </div>

    <div class="stat-card">
      <div class="icon-box yellow"><i class="ri-time-line"></i></div>
      <div>
        <div class="stat-number"><%= stats.pending %></div>
        <div class="stat-label">Pending</div>
      </div>
    </div>
  </div>

  <!-- ORDERS -->
  <% orders.forEach(order => { %>
  <div class="order-card">

    <div class="order-header" onclick="toggleOrder('<%= order._id %>')">
      <div class="order-left">
        <div class="product-icon">
          <i class="ri-archive-line"></i>
        </div>

        <div>
          <small><%= order.orderId %></small>
          <span class="badge <%= order.status === 'Delivered' ? 'badge-green' : 'badge-blue' %>">
            <%= order.status %>
          </span>
          <h3><%= order.items[0].product.name %></h3>
          <small>
            <%= order.items[0].quantity %> units • ₹<%= order.totalAmount.toLocaleString() %>
          </small>
        </div>
      </div>

      <div>
        <i class="ri-arrow-down-s-line"></i>
        <div>
          <small><%= order.createdAt.toDateString() %></small><br>
          <span style="color:#16a34a">
            Delivery: <%= order.expectedDelivery?.toDateString() %>
          </span>
        </div>
      </div>
    </div>    <!-- DETAILS -->
    <div class="order-details" id="order-<%= order._id %>">

      <!-- 5-STEP VISUAL ORDER PROGRESSION TIMELINE -->
      <div class="mb-4">
        <h5 class="fw-bold mb-3"><i class="fa-solid fa-truck-ramp-box text-success me-2"></i> Live Dispatch & Delivery Status</h5>
        <%
          const stages = ["Placed", "Mandi Inspected", "Waybill Generated", "In Transit", "Delivered"];
          let activeIndex = 0;
          if (order.status === 'Processing') activeIndex = 1;
          else if (order.status === 'In Transit') activeIndex = 3;
          else if (order.status === 'Delivered') activeIndex = 4;
        %>
        <div class="order-tracking-timeline">
          <div class="tracking-step <%= activeIndex >= 0 ? (activeIndex === 0 ? 'active' : 'completed') : '' %>">
            <div class="tracking-node"><i class="fa-solid fa-file-signature"></i></div>
            <div class="tracking-label">Order Placed</div>
          </div>
          <div class="tracking-step <%= activeIndex >= 1 ? (activeIndex === 1 ? 'active' : 'completed') : '' %>">
            <div class="tracking-node"><i class="fa-solid fa-certificate"></i></div>
            <div class="tracking-label">Mandi Inspected</div>
          </div>
          <div class="tracking-step <%= activeIndex >= 2 ? (activeIndex === 2 ? 'active' : 'completed') : '' %>">
            <div class="tracking-node"><i class="fa-solid fa-receipt"></i></div>
            <div class="tracking-label">E-Waybill</div>
          </div>
          <div class="tracking-step <%= activeIndex >= 3 ? (activeIndex === 3 ? 'active' : 'completed') : '' %>">
            <div class="tracking-node"><i class="fa-solid fa-truck"></i></div>
            <div class="tracking-label">In-Transit</div>
          </div>
          <div class="tracking-step <%= activeIndex >= 4 ? 'completed' : '' %>">
            <div class="tracking-node"><i class="fa-solid fa-house-chimney"></i></div>
            <div class="tracking-label">Delivered</div>
          </div>
        </div>
      </div>

      <!-- DELIVERY INFO & INVOICE ACTIONS -->
      <div class="row g-3">
        <div class="col-md-7">
          <div class="delivery-box h-100">
            <h6 class="fw-bold mb-2"><i class="fa-solid fa-location-dot text-danger me-1"></i> Delivery Logistics</h6>
            <p class="mb-1 text-muted small"><strong>Destination:</strong> <%= order.deliveryAddress %></p>
            <p class="mb-0 text-muted small"><strong>Target Delivery Window:</strong> <%= order.expectedDelivery?.toDateString() %></p>
          </div>
        </div>
        <div class="col-md-5">
          <div class="delivery-box h-100 d-flex flex-column justify-content-between">
            <div>
              <h6 class="fw-bold mb-2"><i class="fa-solid fa-file-invoice text-success me-1"></i> Documentation & Billing</h6>
              <small class="text-muted d-block mb-2">GST Tax Invoice & Mandi Cess Pass</small>
            </div>
            <div class="d-flex gap-2">
              <button 
                type="button" 
                class="btn btn-sm btn-outline-success flex-grow-1 fw-bold"
                onclick="openInvoicePreview('<%= order.orderId %>', '<%= order.items[0]?.product?.name.replace(/'/g, "\\'") %>', <%= order.items[0]?.quantity %>, <%= order.totalAmount %>, '<%= order.deliveryAddress.replace(/'/g, "\\'") %>', '<%= order.createdAt.toDateString() %>', '<%= order.status %>')"
              >
                <i class="fa-solid fa-file-invoice me-1"></i> View Tax Invoice
              </button>
            </div>
          </div>
        </div>
      </div>

      <% if (user && user.role === 'admin') { %>
      <div class="delivery-box mt-3">
        <h6 class="fw-bold mb-2">Update Order Status</h6>
        <form action="/orders/<%= order._id %>/status" method="POST" class="d-flex gap-2 align-items-center flex-wrap">
          <select name="status" class="form-select form-select-sm" style="max-width: 220px;">
            <option value="Pending" <%= order.status === 'Pending' ? 'selected' : '' %>>Pending</option>
            <option value="Processing" <%= order.status === 'Processing' ? 'selected' : '' %>>Processing</option>
            <option value="In Transit" <%= order.status === 'In Transit' ? 'selected' : '' %>>In Transit</option>
            <option value="Delivered" <%= order.status === 'Delivered' ? 'selected' : '' %>>Delivered</option>
          </select>
          <button type="submit" class="btn btn-sm btn-primary">Update Status</button>
        </form>
      </div>
      <% } %>

    </div>

  </div>
  <% }) %>

</div>

<%- include("partials/footer") %>

<script>
  function toggleOrder(id) {
    const el = document.getElementById("order-" + id);
    if (!el) return;
    el.style.display = el.style.display === "block" ? "none" : "block";
  }
</script>

</body>
</html>