<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>JD Mart | Shopping Cart</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-sRIl4kxILFvY47J16cr9ZwB07vP4J8+LH7qKQnuqkuIAvNWLzeN8tE5YBujZqJLB" crossorigin="anonymous">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/7.0.1/css/all.min.css">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="/css/style.css">
    <link rel="stylesheet" href="/css/orders.css">
    <style>
        .cart-empty {
            text-align: center;
            padding: 60px 20px;
        }
        .cart-empty i {
            font-size: 64px;
            color: #ccc;
            margin-bottom: 20px;
        }
        .cart-item-image {
            width: 80px;
            height: 80px;
            background-size: cover;
            background-position: center;
            border-radius: 8px;
        }
        .qty-input {
            width: 60px;
            text-align: center;
            border: 1px solid #ddd;
            border-radius: 4px;
            padding: 5px;
        }
        .remove-btn {
            color: #dc3545;
            background: none;
            border: none;
            cursor: pointer;
        }
        .remove-btn:hover {
            color: #c82333;
        }
    </style>
</head>
<body>

<nav class="navbar navbar-expand-lg navbar-light bg-body-light border-bottom sticky-top">
  <div class="container-fluid">
    <a class="navbar-brand d-flex align-items-center" href="/products">
      <img src="/images/image.png" alt="JD Mart Logo" height="40" style="border-radius: 8px;"/>
      <span class="ms-2 fw-bold">JD Mart</span>
    </a>
    <div class="ms-auto me-4 d-flex align-items-center">
      <i class="fa-solid fa-location-dot me-1" style="color: #16a34a;"></i>
      <span id="locationText" style="font-size: 15px;">Getting location...</span>
    </div>
    <div class="collapse navbar-collapse" id="navbarNavAltMarkup">
      <div class="navbar-search ms-3">
        <input type="text" id="productSearch" placeholder="Search for crops..." class="form-control" />
      </div>
      <div class="navbar-icons ms-3">
        <a href="/notifications" class="notification-icon" title="Notifications">
          <i class="fa-regular fa-bell"></i>
          <% if (typeof notificationCount !== 'undefined' && notificationCount > 0) { %>
            <span class="notification-badge"><%= notificationCount > 9 ? '9+' : notificationCount %></span>
          <% } %>
        </a>
        <a href="/cart" class="cart-icon active">
          <i class="fa-solid fa-cart-shopping"></i>
          <span class="cart-badge"><%= cartCount || 0 %></span>
        </a>
        <div class="navbar-user" id="userDropdown">
          <div class="avatar">
            <%= user && user.fullName ? user.fullName.charAt(0).toUpperCase() : "U" %>
          </div>
          <span><%= user && user.fullName ? user.fullName.split(" ")[0] : "Guest" %></span>
          <i class="fa-solid fa-chevron-down"></i>
          <div class="jd-user-menu">
            <div class="jd-user-info">
              <strong><%= user && user.fullName ? user.fullName : "Guest User" %></strong>
              <small><%= user && user.email ? user.email : "Not logged in" %></small>
            </div>
            <a href="/profile"><i class="fa-regular fa-user"></i> Profile</a>
            <a href="/orders"><i class="fa-solid fa-box"></i> Orders</a>
            <a href="/cart"><i class="fa-solid fa-cart-shopping"></i> Cart</a>
            <div class="jd-divider"></div>
            <a href="/logout" class="logout"><i class="fa-solid fa-right-from-bracket"></i> Logout</a>
          </div>
        </div>
      </div>
    </div>
  </div>
</nav>

<div class="container mt-4">
    <div class="d-flex align-items-center mb-4">
        <a href="/products" class="text-decoration-none">
            <i class="fa-solid fa-arrow-left me-2"></i> Back to Products
        </a>
    </div>

    <h2 class="mb-4">Shopping Cart</h2>

    <% if (typeof error !== 'undefined' && error) { %>
        <div class="alert alert-danger"><%= error %></div>
    <% } %>

    <% if (typeof message !== 'undefined' && message) { %>
        <div class="alert alert-success"><%= message %></div>
    <% } %>

    <% if (!cart || cart.items.length === 0) { %>
        <div class="cart-empty">
            <i class="fa-solid fa-cart-shopping"></i>
            <h3>Your cart is empty</h3>
            <p class="text-muted">Add products to your cart to see them here.</p>
            <a href="/products" class="btn btn-primary mt-3">Browse Products</a>
        </div>
    <% } else { %>
        <div class="row">
            <div class="col-lg-8">
                <div class="card">
                    <div class="card-body p-0">
                        <table class="table mb-0">
                            <thead>
                                <tr>
                                    <th class="ps-4">Product</th>
                                    <th>Price</th>
                                    <th>Quantity</th>
                                    <th>Total</th>
                                    <th class="pe-4"></th>
                                </tr>
                            </thead>
                            <tbody>
                                <% cart.items.forEach(item => { %>
                                    <tr>
                                        <td class="ps-4">
                                            <div class="d-flex align-items-center">
                                                <div class="cart-item-image me-3" 
                                                                                                         >
                                                                                                        <img
                                                                                                            src="<%= getImageUrl(item.product.images) %>"
                                                                                                            alt="<%= item.product.name %>"
                                                                                                            class="cart-item-image-tag"
                                                                                                            onerror="this.onerror=null;this.src='<%= getCropPlaceholder(item.product.category || item.product.name) %>'"
                                                                                                        >
                                                </div>
                                                <div>
                                                    <strong><%= item.product.name %></strong>
                                                    <br>
                                                    <small class="text-muted"><%= item.product.category %></small>
                                                    <% 
                                                      const actualAvailable = Math.max(0, item.product.available - (item.product.reserved || 0));
                                                      if (actualAvailable <= 0) {
                                                    %>
                                                      <br><span class="badge bg-danger mt-1">Out of Stock</span>
                                                    <% } else if (actualAvailable <= 5) { %>
                                                      <br><span class="badge bg-warning mt-1">Only <%= actualAvailable %> units available</span>
                                                    <% } %>
                                                </div>
                                            </div>
                                        </td>
                                        <td>₹<%= (item.priceAtAdd / 100).toFixed(2) %>/kg</td>
                                        <td>
                                            <% const actualAvailable = Math.max(0, item.product.available - (item.product.reserved || 0)); %>
                                            <form action="/cart/update/<%= item.product._id %>" method="POST" class="d-flex align-items-center">
                                                <input type="number" name="quantity" value="<%= item.quantity %>" 
                                                       min="1" max="<%= actualAvailable %>" 
                                                       class="qty-input" />
                                                <button type="submit" class="btn btn-sm btn-outline-secondary ms-2">
                                                    <i class="fa-solid fa-refresh"></i>
                                                </button>
                                            </form>
                                        </td>
                                        <td>
                                            <strong>₹<%= ((item.quantity * item.priceAtAdd) / 100).toFixed(2) %></strong>
                                        </td>
                                        <td class="pe-4">
                                            <form action="/cart/remove/<%= item.product._id %>" method="POST">
                                                <button type="submit" class="remove-btn" title="Remove item">
                                                    <i class="fa-solid fa-trash fa-lg"></i>
                                                </button>
                                            </form>
                                        </td>
                                    </tr>
                                <% }) %>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
            
            <div class="col-lg-4">
                <div class="card">
                    <div class="card-header bg-white">
                        <h5 class="mb-0">Order Summary</h5>
                    </div>
                    <div class="card-body">
                        <div class="d-flex justify-content-between mb-2">
                            <span>Subtotal (<%= cart.getTotalQuantity() %> items)</span>
                            <strong>₹<%= (totalAmount / 100).toFixed(2) %></strong>
                        </div>
                        <div class="d-flex justify-content-between mb-2">
                            <span>Delivery</span>
                            <span class="text-success">FREE</span>
                        </div>
                        <hr>
                        <div class="d-flex justify-content-between mb-3">
                            <strong>Total</strong>
                            <strong class="text-primary">₹<%= (totalAmount / 100).toFixed(2) %></strong>
                        </div>
                        
                        <form action="/checkout" method="GET">
                            <button type="submit" class="btn btn-success w-100 py-2">
                                <i class="fa-solid fa-check me-2"></i> Checkout Now
                            </button>
                        </form>
                        
                        <div class="mt-3 text-center">
                            <small class="text-muted">
                                <i class="fa-solid fa-info-circle me-1"></i>
                                Delivery to: <%= user.defaultAddress || "Update address in profile" %>
                            </small>
                        </div>
                    </div>
                </div>
                
                <div class="mt-3">
                    <form action="/cart/clear" method="POST">
                        <button type="submit" class="btn btn-outline-danger w-100">
                            <i class="fa-solid fa-trash me-2"></i> Clear Cart
                        </button>
                    </form>
                </div>
            </div>
        </div>
    <% } %>
</div>

<footer class="jd-footer-section mt-5">
  <div class="container-fluid px-5 mt-3">
    <div class="text-center pb-3">
      <small>© <%= new Date().getFullYear() %> JD Mart. All rights reserved.</small>
    </div>
  </div>
</footer>

<script src="/js/script.js"></script>
</body>
</html>
