<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>JD Mart | Shopping Cart</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-sRIl4kxILFvY47J16cr9ZwB07vP4J8+LH7qKQnuqkuIAvNWLzeN8tE5YBujZqJLB" crossorigin="anonymous">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/7.0.1/css/all.min.css">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="/css/style.css">
    <style>
        .cart-hero-header {
            background: linear-gradient(135deg, #15803d 0%, #16a34a 100%);
            color: #fff;
            padding: 2rem 0;
            margin-bottom: 2rem;
            border-radius: 0 0 1rem 1rem;
        }
        .cart-empty {
            text-align: center;
            padding: 80px 20px;
            background: #fff;
            border-radius: 1rem;
            border: 1px dashed #cbd5e1;
        }
        .cart-empty i {
            font-size: 64px;
            color: #94a3b8;
            margin-bottom: 20px;
        }
        .cart-item-thumb {
            width: 72px;
            height: 72px;
            border-radius: 10px;
            object-fit: cover;
            border: 1px solid #e2e8f0;
            background: #f8fafc;
        }
        .cart-stepper-group {
            display: inline-flex;
            align-items: center;
            border: 1px solid #cbd5e1;
            border-radius: 8px;
            overflow: hidden;
            background: #fff;
        }
        .cart-step-btn {
            border: none;
            background: #f1f5f9;
            color: #334155;
            width: 32px;
            height: 32px;
            font-size: 16px;
            font-weight: 700;
            display: flex;
            align-items: center;
            justify-content: center;
            cursor: pointer;
            transition: all 0.2s;
        }
        .cart-step-btn:hover {
            background: #e2e8f0;
            color: #16a34a;
        }
        .cart-qty-input {
            width: 48px;
            height: 32px;
            border: none;
            text-align: center;
            font-weight: 600;
            font-size: 0.9rem;
        }
        .cart-qty-input:focus {
            outline: none;
        }
        .cart-remove-btn {
            color: #94a3b8;
            background: none;
            border: none;
            padding: 6px;
            border-radius: 6px;
            cursor: pointer;
            transition: all 0.2s;
        }
        .cart-remove-btn:hover {
            color: #ef4444;
            background: #fee2e2;
        }
        .sticky-summary-card {
            position: sticky;
            top: 90px;
            border: 1px solid #e2e8f0;
            border-radius: 1rem;
            box-shadow: 0 4px 15px rgba(0,0,0,0.04);
            background: #fff;
            overflow: hidden;
        }
        .cart-mobile-item {
            background: #fff;
            border: 1px solid #e2e8f0;
            border-radius: 12px;
            padding: 1rem;
            margin-bottom: 1rem;
        }
        .trust-badge-box {
            background: #f0fdf4;
            border: 1px solid #bbf7d0;
            border-radius: 8px;
            padding: 0.75rem;
            font-size: 0.8rem;
            color: #166534;
        }
    </style>
</head>
<body class="bg-light">

<%- include("partials/header") %>

<!-- HERO BANNER -->
<div class="cart-hero-header">
    <div class="container">
        <div class="d-flex align-items-center justify-content-between flex-wrap gap-2">
            <div>
                <a href="/products" class="text-white text-decoration-none small d-inline-flex align-items-center mb-2 opacity-75 hover-opacity-100">
                    <i class="fa-solid fa-arrow-left me-1"></i> Back to Agricultural Catalog
                </a>
                <h2 class="mb-0 fw-bold"><i class="fa-solid fa-cart-shopping me-2"></i> Wholesale Shopping Cart</h2>
            </div>
            <% if (cart && cart.items && cart.items.length > 0) { %>
                <span class="badge bg-white text-success px-3 py-2 rounded-pill fw-bold">
                    <%= cart.getTotalQuantity() %> Total Lot Units
                </span>
            <% } %>
        </div>
    </div>
</div>

<div class="container mb-5">
    <% if (typeof error !== 'undefined' && error) { %>
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <i class="fa-solid fa-circle-exclamation me-2"></i> <%= error %>
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    <% } %>

    <% if (typeof message !== 'undefined' && message) { %>
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="fa-solid fa-circle-check me-2"></i> <%= message %>
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    <% } %>

    <% if (!cart || cart.items.length === 0) { %>
        <div class="cart-empty shadow-sm">
            <i class="fa-solid fa-cart-arrow-down"></i>
            <h3 class="fw-bold text-dark">Your Agricultural Cart is Empty</h3>
            <p class="text-muted mb-4">No commodity lots have been added yet. Explore live APMC listings with doorstep delivery.</p>
            <a href="/products" class="btn btn-success px-4 py-2 rounded-pill fw-semibold shadow-sm">
                <i class="fa-solid fa-wheat-awn me-2"></i> Explore Mandi Catalog
            </a>
        </div>
    <% } else { %>
        <div class="row g-4">
            <!-- ITEMS COLUMN -->
            <div class="col-lg-8">
                <!-- DESKTOP TABLE VIEW -->
                <div class="card border-0 shadow-sm rounded-4 overflow-hidden d-none d-md-block">
                    <div class="table-responsive">
                        <table class="table align-middle mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th class="ps-4 py-3 text-secondary small fw-bold">COMMODITY LOT</th>
                                    <th class="py-3 text-secondary small fw-bold">RATE (₹/KG)</th>
                                    <th class="py-3 text-secondary small fw-bold text-center">QUANTITY</th>
                                    <th class="py-3 text-secondary small fw-bold">SUBTOTAL</th>
                                    <th class="pe-4 py-3 text-end text-secondary small fw-bold">ACTION</th>
                                </tr>
                            </thead>
                            <tbody>
                                <% cart.items.forEach(item => { 
                                    const actualAvailable = Math.max(1, item.product.available - (item.product.reserved || 0));
                                %>
                                    <tr class="border-bottom">
                                        <td class="ps-4 py-3">
                                            <div class="d-flex align-items-center gap-3">
                                                <img
                                                    src="<%= getImageUrl(item.product.images) %>"
                                                    alt="<%= item.product.name %>"
                                                    class="cart-item-thumb"
                                                    onerror="this.onerror=null;this.src='<%= getCropPlaceholder(item.product.category || item.product.name) %>'"
                                                >
                                                <div>
                                                    <h6 class="mb-0 fw-bold">
                                                        <a href="/products/<%= item.product._id %>" class="text-decoration-none text-dark hover-success">
                                                            <%= item.product.name %>
                                                        </a>
                                                    </h6>
                                                    <div class="d-flex align-items-center gap-2 mt-1">
                                                        <span class="badge bg-success-subtle text-success border border-success-subtle rounded-pill small">
                                                            <%= item.product.category %>
                                                        </span>
                                                        <span class="badge bg-primary-subtle text-primary border border-primary-subtle rounded-pill small">
                                                            Grade <%= item.product.grade %>
                                                        </span>
                                                    </div>
                                                    <% if (actualAvailable <= 5) { %>
                                                        <span class="badge bg-warning-subtle text-warning-emphasis border border-warning-subtle mt-1 small">
                                                            Only <%= actualAvailable %> left
                                                        </span>
                                                    <% } %>
                                                </div>
                                            </div>
                                        </td>
                                        <td class="py-3 fw-semibold text-dark">
                                            ₹<%= (item.priceAtAdd / 100).toFixed(2) %>
                                            <small class="text-muted d-block" style="font-size: 0.75rem;">₹<%= (item.priceAtAdd).toFixed(0) %>/Qtl</small>
                                        </td>
                                        <td class="py-3 text-center">
                                            <form action="/cart/update/<%= item.product._id %>" method="POST" class="d-inline-flex justify-content-center">
                                                <div class="cart-stepper-group">
                                                    <button type="button" class="cart-step-btn" onclick="stepCartQty(this, -1); this.closest('form').submit();" title="Decrease">−</button>
                                                    <input type="number" name="quantity" value="<%= item.quantity %>" 
                                                           min="1" max="<%= actualAvailable %>" 
                                                           class="cart-qty-input" />
                                                    <button type="button" class="cart-step-btn" onclick="stepCartQty(this, 1); this.closest('form').submit();" title="Increase">+</button>
                                                </div>
                                            </form>
                                        </td>
                                        <td class="py-3 fw-bold text-success">
                                            ₹<%= ((item.quantity * item.priceAtAdd) / 100).toLocaleString('en-IN', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) %>
                                        </td>
                                        <td class="pe-4 py-3 text-end">
                                            <form action="/cart/remove/<%= item.product._id %>" method="POST" class="d-inline">
                                                <button type="submit" class="cart-remove-btn" title="Remove from cart">
                                                    <i class="fa-solid fa-trash-can fa-lg"></i>
                                                </button>
                                            </form>
                                        </td>
                                    </tr>
                                <% }) %>
                            </tbody>
                        </table>
                    </div>
                </div>

                <!-- MOBILE CARD VIEW -->
                <div class="d-md-none">
                    <% cart.items.forEach(item => { 
                        const actualAvailable = Math.max(1, item.product.available - (item.product.reserved || 0));
                    %>
                        <div class="cart-mobile-item shadow-sm">
                            <div class="d-flex gap-3">
                                <img
                                    src="<%= getImageUrl(item.product.images) %>"
                                    alt="<%= item.product.name %>"
                                    class="cart-item-thumb"
                                    onerror="this.onerror=null;this.src='<%= getCropPlaceholder(item.product.category || item.product.name) %>'"
                                >
                                <div class="flex-grow-1">
                                    <div class="d-flex justify-content-between align-items-start">
                                        <h6 class="fw-bold mb-1"><%= item.product.name %></h6>
                                        <form action="/cart/remove/<%= item.product._id %>" method="POST">
                                            <button type="submit" class="cart-remove-btn text-danger">
                                                <i class="fa-solid fa-trash-can"></i>
                                            </button>
                                        </form>
                                    </div>
                                    <span class="badge bg-success-subtle text-success small">Grade <%= item.product.grade %></span>
                                    <div class="text-success fw-bold mt-1">₹<%= (item.priceAtAdd / 100).toFixed(2) %>/kg</div>
                                </div>
                            </div>

                            <div class="d-flex justify-content-between align-items-center mt-3 pt-2 border-top">
                                <form action="/cart/update/<%= item.product._id %>" method="POST">
                                    <div class="cart-stepper-group">
                                        <button type="button" class="cart-step-btn" onclick="stepCartQty(this, -1); this.closest('form').submit();">−</button>
                                        <input type="number" name="quantity" value="<%= item.quantity %>" min="1" max="<%= actualAvailable %>" class="cart-qty-input" />
                                        <button type="button" class="cart-step-btn" onclick="stepCartQty(this, 1); this.closest('form').submit();">+</button>
                                    </div>
                                </form>
                                <div class="text-end">
                                    <small class="text-muted d-block">Subtotal</small>
                                    <strong class="text-success">₹<%= ((item.quantity * item.priceAtAdd) / 100).toFixed(2) %></strong>
                                </div>
                            </div>
                        </div>
                    <% }) %>
                </div>

                <div class="d-flex justify-content-between align-items-center mt-3 flex-wrap gap-2">
                    <a href="/products" class="btn btn-outline-secondary btn-sm fw-semibold">
                        <i class="fa-solid fa-arrow-left me-1"></i> Continue Shopping
                    </a>
                    <form action="/cart/clear" method="POST" onsubmit="return confirm('Clear entire cart?');">
                        <button type="submit" class="btn btn-outline-danger btn-sm fw-semibold">
                            <i class="fa-solid fa-trash me-1"></i> Clear Cart
                        </button>
                    </form>
                </div>
            </div>

            <!-- ORDER SUMMARY STICKY SIDEBAR -->
            <div class="col-lg-4">
                <div class="sticky-summary-card p-4">
                    <h5 class="fw-bold mb-3 text-dark">
                        <i class="fa-solid fa-receipt text-success me-2"></i> Order Summary
                    </h5>

                    <!-- FREIGHT MILESTONE -->
                    <div class="p-3 bg-light rounded-3 mb-3 border">
                        <div class="d-flex justify-content-between align-items-center small mb-1">
                            <span class="fw-bold text-success"><i class="fa-solid fa-truck-fast me-1"></i> Free APMC Delivery</span>
                            <span class="text-muted fw-semibold">Unlocked</span>
                        </div>
                        <div class="progress" style="height: 6px;">
                            <div class="progress-bar bg-success" role="progressbar" style="width: 100%;"></div>
                        </div>
                        <small class="text-muted mt-1 d-block" style="font-size: 0.72rem;">Free mandi yard delivery applied automatically.</small>
                    </div>

                    <div class="d-flex justify-content-between mb-2 small text-muted">
                        <span>Items Quantity:</span>
                        <strong class="text-dark"><%= cart.getTotalQuantity() %> units</strong>
                    </div>

                    <div class="d-flex justify-content-between mb-2 small text-muted">
                        <span>Commodity Subtotal:</span>
                        <strong class="text-dark">₹<%= (totalAmount / 100).toLocaleString('en-IN', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) %></strong>
                    </div>

                    <div class="d-flex justify-content-between mb-2 small text-muted">
                        <span>Mandi Cess & GST (5%):</span>
                        <span class="text-dark">₹<%= ((totalAmount * 0.05) / 100).toFixed(2) %></span>
                    </div>

                    <div class="d-flex justify-content-between mb-3 small text-muted">
                        <span>Logistics & Freight:</span>
                        <span class="text-success fw-bold">FREE</span>
                    </div>

                    <div class="border-top pt-3 mb-4 d-flex justify-content-between align-items-center">
                        <div>
                            <span class="fs-6 fw-bold text-dark d-block">Estimated Total:</span>
                            <small class="text-muted">(Incl. of taxes)</small>
                        </div>
                        <span class="fs-4 fw-bold text-success">
                            ₹<%= ((totalAmount * 1.05) / 100).toLocaleString('en-IN', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) %>
                        </span>
                    </div>

                    <form action="/checkout" method="GET">
                        <button type="submit" class="btn btn-success w-100 py-2.5 rounded-3 fw-bold fs-6 shadow-sm mb-3">
                            <i class="fa-solid fa-shield-halved me-2"></i> Proceed to Checkout
                        </button>
                    </form>

                    <!-- TRUST BADGES -->
                    <div class="trust-badge-box">
                        <div class="d-flex align-items-center gap-2 mb-1">
                            <i class="fa-solid fa-shield-halved fs-5"></i>
                            <strong>100% Escrow Protected</strong>
                        </div>
                        <p class="mb-0" style="font-size: 0.75rem;">
                            Your payment is held safely in escrow until you inspect and accept the agricultural commodity lot on arrival.
                        </p>
                    </div>

                    <div class="mt-3 text-center">
                        <small class="text-muted" style="font-size: 0.75rem;">
                            <i class="fa-solid fa-location-dot text-success me-1"></i>
                            Delivery to: <strong><%= (user && user.defaultAddress) ? user.defaultAddress : "Saved address or mandi yard" %></strong>
                        </small>
                    </div>
                </div>
            </div>
        </div>
    <% } %>
</div>

<%- include("partials/footer") %>

<script src="/js/script.js"></script>
</body>
</html>
